{
  config,
  lix,
  paths,
  entryAfter,
  pkgs,
  ...
}: let
  inherit (lix.attrsets.aggregation) recursiveUpdate;
  inherit (lix.attrsets.transformation) mapAttrsToList;
  inherit (lix.debug.assertions) withContext;
  inherit (lix.lists.transformation) imap1;
  inherit (lix.modules.construction) mkContext mkConfig mkIf;
  inherit (lix.sources.packages) pkgsFrom;
  inherit (lix.strings.construction) concat fromBool optionalString;
  inherit (lix.strings.transformation) escapeShellArg;
  inherit (lix.strings.transformation) hasInfix;
  inherit (lix.types.predicates) isBool isFloat isInt;
  inherit (pkgs) writeText makeWrapper symlinkJoin;
  inherit (lix.filesystem.construction) concatPath;

  tool = let
    all = pkgsFrom {
      inherit inputs pkgs;
      sources = {
        #? `null` means taken from nixpkgs
        coreutils = null;
        variety = null;
      };
      required = true;
    };
    bins = let
      coreutils = "${all.coreutils.paths.binary}";
      inherit (all.binaries) git;
      rm = "${coreutils}/rm";
    in {
      inherit git rm;
      gitCfgFile = "${git} config --file";
      rmf = "${rm} --force";
    };
  in {inherit all bins;};
  inherit (tool) bins;

  # wallpapers=
  # TODO: This doesn't exist
  cfg = config.programs.variety;

  paths' =
    recursiveUpdate {
      wallpapers = concatPath {
        root = config.home.homeDirectory;
        stem = ["Pictures" "Wallpapers"];
      };
      variety = {
        profiles = {
          main =
            paths.variety.profile or (
              paths.wallpaper.variety.profile or (concatPath {
                root = config.xdg.configHome;
                stem = "variety";
              })
            );
          extra =
            paths.wallpaper.variety.profile or (concatPath {
              root = config.xdg.configHome;
              stem = "variety-profiles";
            });
        };
      };
    }
    paths;

  scripts = import ./scripts.nix {
    inherit paths pkgs lix;
    inherit (cfg) runtimeInputs;
  };

  conf = concat "/" [paths'.variety.profiles.main "variety.conf"];
  wallhavenApiKey = "@WALLHAVEN_API_KEY@"; #TODO Use sops for this

  render = {
    settings,
    sources,
    filters,
  }: let
    # Variety reads variety.conf with ConfigObj: unquoted values are fine,
    # except that a comma makes a list and an empty value needs quotes.
    prep = arg:
      if isBool arg
      then fromBool arg
      else if isInt arg || isFloat arg
      then builtins.toJSON arg
      else if arg == "" || hasInfix "," arg
      then
        assert withContext {
          name = "mkSource";
          context = "validating mkSource value";
          assertion = !(hasInfix "\"" arg);
          message = "variety.conf value cannot contain a double quote: ${arg}";
        }; ''"${arg}"''
      else arg;

    scalars = settings:
      concat "\n" (
        mapAttrsToList
        (key: val: "${key} = ${prep val}")
        settings
      );
    sourceLine = input: source: "src${toString input} = ${
      concat "|" (with source; [(fromBool enable) type location])
    }";
    filterLine = input: slice: "filter${toString input} = ${
      concat "|" (with slice; [(fromBool enable) name args])
    }";
  in ''
    # Generated by Nix (programs.variety). Edit the Nix module, not this file.
    ${scalars settings}

    [sources]
    ${concat "\n" (imap1 sourceLine sources)}

    [filters]
    ${concat "\n" (imap1 filterLine filters)}
  '';

  settings =
    (import ./defaults.nix {
      inherit concatPath;
      paths = paths';
    })
    // {
      change_on_start = cfg.change.onStart;
      change_enabled = cfg.change.enable;
      change_interval = cfg.change.interval;
      internet_enabled = cfg.internet;
      safe_mode = cfg.safeMode;

      set_wallpaper_script = "${scripts.setWallpaper}";
      get_wallpaper_script = "${scripts.getWallpaper}";

      download_folder = cfg.folders.downloaded;
      fetched_folder = cfg.folders.fetched;
      favorites_folder = cfg.folders.favorites;
      download_preference_ratio = cfg.downloadPreferenceRatio;
      quota_enabled = cfg.quota.enable;
      quota_size = cfg.quota.size;
      wallhaven_api_key =
        optionalString
        (cfg.wallhaven.apiKeyFile != null)
        wallhavenApiKey;

      wallpaper_auto_rotate = cfg.autoRotate;
      wallpaper_display_mode = cfg.displayMode;

      clipboard_enabled = cfg.clipboard.enable;
      clipboard_use_whitelist = cfg.clipboard.useWhitelist;
      clipboard_hosts = concat "," cfg.clipboard.hosts;

      inherit (cfg) icon;
      copyto_enabled = cfg.copyTo.enable;
      copyto_folder = cfg.copyTo.folder;

      clock_enabled = cfg.clock.enable;
      clock_font = cfg.clock.font;
      clock_date_font = cfg.clock.dateFont;
      clock_filter = cfg.clock.filter;

      quotes_enabled = cfg.quotes.enable;
      change_lock_screen = cfg.lockScreen;
      sync_enabled = cfg.sync;
      stats_enabled = cfg.stats;
    }
    // cfg.extraSettings;

  confFile = writeText "variety.conf" (
    render {
      inherit settings;
      inherit (cfg) sources filters;
    }
  );

  installConf = ''
    run install -Dm644 ${confFile} ${escapeShellArg conf}
    ${optionalString (cfg.wallhaven.apiKeyFile != null) ''
      if [ -z "''${DRY_RUN:-}" ]; then
        key="$(tr -d '\n' < ${escapeShellArg cfg.wallhaven.apiKeyFile})"
        sed -i "s|${wallhavenApiKey}|$key|" ${escapeShellArg conf}
      fi
    ''}
  '';

  # With a named profile, wrap the binary so every call (keybinds, the
  # variety_next/previous/love helpers, the desktop entry) hits that profile.
  package =
    if cfg.profile == null
    then cfg.package
    else
      symlinkJoin {
        name = "variety-profiled";
        paths = [cfg.package];
        nativeBuildInputs = [makeWrapper];
        postBuild = ''
          rm $out/bin/variety
          makeWrapper ${cfg.package}/bin/variety $out/bin/variety \
            --add-flags ${escapeShellArg "--profile ${cfg.profile}"}
        '';
        meta =
          (cfg.package.meta or {})
          // {
            mainProgram = "variety";
          };
      };
in {
  config = mkIf cfg.enable {
    home = {
      packages = [package];

      activation.varietyProfile = entryAfter ["writeBoundary"] (
        if cfg.seedMode == "overwrite"
        then installConf
        else ''
          if [ ! -e ${escapeShellArg conf} ]; then
            ${installConf}
          fi
        ''
      );
    };
  };
}
