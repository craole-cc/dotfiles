{ lib }:
let
  inherit (lib)
    concatStringsSep
    hasInfix
    imap1
    isBool
    isFloat
    isInt
    mapAttrsToList
    ;

  boolStr = b: if b then "True" else "False";

  # Variety reads variety.conf with ConfigObj: unquoted values are fine,
  # except that a comma makes a list and an empty value needs quotes.
  value =
    v:
    if isBool v then
      boolStr v
    else if isInt v || isFloat v then
      builtins.toJSON v
    else if v == "" || hasInfix "," v then
      assert lib.assertMsg (!(hasInfix "\"" v)) "variety.conf value cannot contain a double quote: ${v}";
      ''"${v}"''
    else
      v;

  scalars = settings: concatStringsSep "\n" (mapAttrsToList (k: v: "${k} = ${value v}") settings);

  sourceLine = i: s: "src${toString i} = ${boolStr s.enable}|${s.type}|${s.location}";
  filterLine = i: f: "filter${toString i} = ${boolStr f.enable}|${f.name}|${f.args}";
in
{
  render =
    { settings, sources, filters }:
    ''
      # Generated by Nix (programs.variety). Edit the Nix module, not this file.
      ${scalars settings}

      [sources]
      ${concatStringsSep "\n" (imap1 sourceLine sources)}

      [filters]
      ${concatStringsSep "\n" (imap1 filterLine filters)}
    '';
}
