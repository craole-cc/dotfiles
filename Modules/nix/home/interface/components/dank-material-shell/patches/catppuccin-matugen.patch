+func mergeDynamicAccentColors(stockJSON, dynamicJSON string, mode ColorMode) (string, error) {
+	var stock map[string]map[string]any
+	if err := json.Unmarshal([]byte(stockJSON), &stock); err != nil {
+		return "", fmt.Errorf("parse fixed palette: %w", err)
+	}
+
+	var dynamic ColorsOutput
+	if err := json.Unmarshal([]byte(dynamicJSON), &dynamic); err != nil {
+		return "", fmt.Errorf("parse Matugen palette: %w", err)
+	}
+
+	roles := []string{
+		"primary", "on_primary", "primary_container", "on_primary_container",
+		"secondary", "on_secondary", "secondary_container", "on_secondary_container",
+		"tertiary", "on_tertiary", "tertiary_container", "on_tertiary_container",
+		"inverse_primary", "primary_fixed", "primary_fixed_dim", "on_primary_fixed",
+		"on_primary_fixed_variant", "secondary_fixed", "secondary_fixed_dim",
+		"on_secondary_fixed", "on_secondary_fixed_variant", "tertiary_fixed",
+		"tertiary_fixed_dim", "on_tertiary_fixed", "on_tertiary_fixed_variant",
+		"source_color",
+	}
+	for _, role := range roles {
+		dark, hasDark := dynamic.Colors.Dark[role]
+		light, hasLight := dynamic.Colors.Light[role]
+		if !hasDark && !hasLight {
+			continue
+		}
+		if !hasDark {
+			dark = light
+		}
+		if !hasLight {
+			light = dark
+		}
+		if stock[role] == nil {
+			stock[role] = make(map[string]any)
+		}
+		stock[role]["dark"] = map[string]string{"color": dark}
+		stock[role]["light"] = map[string]string{"color": light}
+		selected := dark
+		if mode == ColorModeLight {
+			selected = light
+		}
+		stock[role]["default"] = map[string]string{"color": selected}
+	}
+
+	merged, err := json.Marshal(stock)
+	if err != nil {
+		return "", fmt.Errorf("encode combined palette: %w", err)
+	}
+	return string(merged), nil
+}
