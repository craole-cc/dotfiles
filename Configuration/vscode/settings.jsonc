{
  "window.autoDetectHighContrast": false,
  "window.autoDetectColorScheme": false,
  "workbench.colorTheme": "Dynamic Base16 DankShell",
  "json.schemaDownload.enable": false,
  "workbench.preferredDarkColorTheme": "Catppuccin Frappé",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.productIconTheme": "el-vsc-v1-icons",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.sideBar.location": "right",
  //> ====================================================
  //> TYPOGRAPHY
  //> ====================================================
  "editor.fontFamily": "'Lilex Nerd Font',monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 18,
  "editor.fontWeight": 500,
  "editor.letterSpacing": 0,
  "editor.lineHeight": 2,
  "editor.tabSize": 2,
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,
  "terminal.integrated.fontFamily": "'Maple Mono NF',monospace",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 18,
  "terminal.integrated.fontWeight": 500,
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.lineHeight": 1.2,
  //> ====================================================
  //> GLOBAL FEATURES
  //> ====================================================
  "license.author": "Craig 'Craole' Cole",
  "license.default": "mit",
  "extensions.ignoreRecommendations": true,
  "update.mode": "manual",
  "window.zoomPerWindow": true,
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.revealIfOpen": true,
  "workbench.experimental.share.enabled": true,
  "workbench.quickOpen.preserveInput": true,
  "workbench.settings.openDefaultKeybindings": true,
  "workbench.startupEditor": "none",
  //> ====================================================
  //> EDITOR FEATURES
  //> ====================================================
  "editor.accessibilitySupport": "off",
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "files.autoSave": "onFocusChange",
  "editor.formatOnSaveMode": "file",
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.insertSpaces": true,
  "editor.lineNumbers": "on",
  "editor.linkedEditing": true,
  "editor.matchBrackets": false,
  "editor.mouseWheelZoom": true,
  "editor.occurrencesHighlight": "off",
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.renderLineHighlight": "gutter",
  "editor.renderWhitespace": "all",
  "editor.selectionHighlight": false,
  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "interface": {
        "italic": true
      },
      "selfParameter": {
        "italic": true
      },
      "keyword": {
        "italic": true
      },
      "*.static": {
        "italic": true
      }
    }
  },
  "editor.renderControlCharacters": false,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.defaultModel": "indentationModel",
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.scrollWithEditor": false,
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "explorer.compactFolders": false,
  "window.menuBarVisibility": "toggle",
  "window.titleBarStyle": "native",
  "workbench.commandPalette.preserveInput": true,
  "workbench.panel.defaultLocation": "bottom",
  "workbench.tree.enableStickyScroll": false,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.ui": "default",
    "*.pdf": "pdf.view",
    "*.db": "default",
    "*.qrc": "qt-core.qrcEditor",
    "*.xlsx": "csvViewer.csvEditor",
    "*.tsv": "csvViewer.csvEditor"
  },
  "workbench.statusBar.visible": true,
  "window.customTitleBarVisibility": "never",
  "window.customMenuBarAltFocus": true,
  //> ====================================================
  //> TERMINAL FEATURES
  //> ====================================================
  "terminal.integrated.allowMnemonics": true,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.terminal.copySelection"
  ],
  "terminal.integrated.confirmOnExit": "never",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.enableImages": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.hideOnStartup": "whenEmpty",
  "terminal.integrated.profiles.windows": {
    "NixOS (WSL)": {
      "path": "${env:windir}\\System32\\wsl.exe",
      "args": [
        "-d",
        "NixOS"
      ]
    },
    "Git Bash": {
      "source": "Git Bash"
    },
    "PowerShell": {
      "source": "PowerShell",
      // "path": "${env:ProgramFiles}\\PowerShell\\7\\pwsh.exe",
      "args": [
        "-NoExit",
        "-Command",
        "& { $env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User') }"
      ],
      "icon": "terminal-powershell"
    },
    "Windows PowerShell": {
      "path": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoExit",
        "-Command",
        "& { $env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User') }"
      ],
      "icon": "terminal-powershell"
    },
    "Nushell": {
      "path": "${env:USERPROFILE}\\AppData\\Local\\Programs\\nu\\bin\\nu.exe"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    }
  },
  "terminal.integrated.mouseWheelZoom": false,
  "terminal.integrated.rightClickBehavior": "copyPaste",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.tabs.location": "right",
  //> ====================================================
  //> FILE HANDLING
  //> ====================================================
  "files.associations": {
    "*.rasi": "css",
    "*.bbmodel": "json",
    "*.sublime-snippet": "xml",
    "*.hbs": "html",
    "*.ejs": "html",
    "*.emu": "html",
    "lesskey": "lesskey",
    "*.Xresources": "xdefaults",
    "i3/config": "i3",
    "i3/*.conf": "i3",
    "polybar/config": "ini",
    "polybar/*.conf": "ini",
    "flake.lock": "json",
    ".bash*": "shellscript",
    ".dotsrc": "coffeescript",
    ".editorconfig": "ini",
    ".env": "env",
    ".env*": "dotenv",
    ".sqruff": "properties",
    "*.bash": "shellscript",
    "*.css": "css",
    "*.erb": "ruby",
    "*.gs": "javascript",
    "*.init": "shellscript",
    "*.layout": "json",
    "*.log": "log",
    "*.nix": "nix",
    "*.nu": "nushell",
    "*.rs": "rust",
    "*.sh": "shellscript",
    "*.typ": "typst",
    "**/*.conf": "ini",
    "**/conf*/{fuzzel,ghostty,mpv,hyprland}/*": "ini",
    "**/conf*/{raffi}/*": "yaml",
    "*envrc": "shellscript",
    "*gitignore": "ignore",
    "*ignore": "ignore",
    "*shellcheckrc": "shellscript",
    "editorconfig": "ini",
    "Gemfile": "ruby",
    "LICENSE-MIT": "txt",
    "LICENSE": "txt",
    "mise.lock": "toml",
    "README": "markdown",
    "*.ft": "rust"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/$RECYCLE.BIN": false,
    "**/*.lock": false,
    "**/.DS_Store": false,
    "**/.admin": false,
    "**/.bin": false,
    "**/.codex": false,
    "**/.direnv": false,
    "**/.editorconfig": false,
    "**/.env*": false,
    "**/.git": false,
    "**/.gitattributes": false,
    "**/.gitmodules": false,
    "**/mise.toml": false,
    "**/.mise.toml": false,
    "**/.github": false,
    "**/.gitignore": false,
    "**/.ignore": false,
    "**/.helix": false,
    "**/.hg": false,
    "**/.jj": false,
    "**/.justfile": false,
    "**/.markdownlint.yaml": false,
    "**/.pre-commit-config.yaml": false,
    "**/.rust*": false,
    "**/.shellcheckrc": false,
    "**/.svn": false,
    "**/askama.toml": false,
    "**/.clippy.toml": false,
    "**/clippy.toml": false,
    "**/.treefmt.toml": false,
    "**/.typos.toml": false,
    "**/.vscode": false,
    "**/CODE_OF_CONDUCT": false,
    "**/CODE_OF_CONDUCT.md": false,
    "**/CONTRIBUTING": false,
    "**/CONTRIBUTING.md": false,
    "**/LICENSE": false,
    "**/LICENSE-*": false,
    "**/Downloads": false,
    "**/LICENSE.md": false,
    "**/README": false,
    "**/README.md": false,
    "**/SECURITY": false,
    "**/SECURITY.md": false,
    "**/System Volume Information": false,
    "**/Thumbs.db": false,
    "**/archive": false,
    "**/deno.json": false,
    "**/deno.jsonc": false,
    "**/justfile": false,
    "**/review": false,
    "**/Review": false,
    "**/rust-analyzer.toml": false,
    "**/rust-toolchain*": false,
    "**/rust-toolchain.toml": false,
    "**/rustfmt.toml": false,
    "**/*.bac": false,
    "**/target": false,
    "**/treefmt.toml": false
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.local/* *": true,
    "**/.vscode-server-insiders/* *": true,
    "**/* cache/* *": true,
    "**/.trunk/*actions/": true,
    "**/.trunk/*logs/": true,
    "**/.trunk/*notifications/": true,
    "**/.trunk/*out/": true,
    "**/.trunk/*plugins/": true
  },
  //> ====================================================
  //> GIT CONFIGURATION
  //> ====================================================
  "explorer.excludeGitIgnore": false,
  "git.allowForcePush": true,
  "git.autofetch": true,
  "git.confirmForcePush": false,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.enabled": true,
  "git.ignoreRebaseWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "git.rebaseWhenSync": true,
  //> ====================================================
  //> LANGUAGE-SPECIFIC SETTINGS
  //> ====================================================
  "settingsSync.ignoredExtensions": [
    "constneo.vscode-nushell-format",
    "jnoortheen.nix-ide",
    "mkhl.direnv",
    "ms-edgedevtools.vscode-edge-devtools",
    "ms-vscode-remote.remote-wsl"
  ],
  "[cypher]": {
    // "editor.defaultFormatter": "neo4j-extensions.neo4j-for-vscode",
    "editor.semanticHighlighting.enabled": true
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[dockercompose]": {
    // "editor.defaultFormatter": "bluebrown.yamlfmt"
  },
  "[dockerfile]": {
    // "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "[dotenv]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[gitignore]": {},
  "[html]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[ignore]": {
    // "editor.defaultFormatter": "lkrms.inifmt"
  },
  "[ini]": {
    "editor.defaultFormatter": "lkrms.inifmt"
    // "editor.defaultFormatter": "lkrms.inifmt"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always"
    },
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always"
    },
    "editor.formatOnSave": true
  },
  //|-> Just
  // "vscode-just.useSingleTerminal": true,
  // "vscode-just.formatOnSave": true,
  // "vscode-just.justPath": "C:\\\\Users\\\\Administrator\\\\scoop\\\\shims\\\\just.exe"
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnSave": true
  },
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "alejandra",
          "-q",
          "-"
          //   "sh",
          //   "-c",
          //   "original=$(cat); fixed=$(printf '%s' \"$original\" | statix fix --stdin); [ -n \"$fixed\" ] || fixed=$original; merged=$(printf '%s' \"$fixed\" | perl -0pe \"$1\"); [ -n \"$merged\" ] || merged=$fixed; printf '%s' \"$merged\" | alejandra -q - || printf '%s' \"$original\"",
          //   "sh",
          //   "1 while s/^([ \\t]*)inherit[ \\t]+([^;(){}#\"\\/*]+);\\n\\1inherit[ \\t]+([^;(){}#\"\\/*]+);/$1inherit $2 $3;/m;"
        ]
      }
    }
  },
  "lintRunner.tools": {
    "shellcheck": {
      "kind": "diagnostic",
      "command": "shellcheck",
      "args": [
        "--enable=all",
        "--format=gcc",
        "${file}"
      ],
      "successExitCodes": [
        0,
        1
      ],
      "parser": {
        "flags": "gm",
        "pattern": "^.+?:(?<line>\\d+):(?<col>\\d+): (?<severity>error|warning|note): (?<message>.+)$"
      }
    },
    "statix": {
      "kind": "diagnostic",
      "command": "statix",
      "args": [
        "check",
        "--format",
        "errfmt",
        "${file}"
      ],
      "successExitCodes": [
        0,
        1
      ],
      "parser": {
        "flags": "gm",
        "pattern": "^.+?>(?<line>\\d+):(?<col>\\d+):[WE]:(?<code>\\d+):(?<message>.+)$"
      }
    }
  },
  "lintRunner.targets": [
    {
      "name": "Nix",
      "match": {
        "languages": [
          "nix"
        ],
        "files": [
          "**/*.nix"
        ]
      },
      "onOpen": {
        "strategy": "sequence",
        "tools": [
          "statix"
        ]
      },
      "onSave": {
        "strategy": "sequence",
        "tools": [
          "statix"
        ]
      },
      "manual": {
        "strategy": "sequence",
        "tools": [
          "statix"
        ]
      }
    },
    {
      "name": "Shell",
      "match": {
        "languages": [
          "shellscript"
        ]
      },
      "onOpen": {
        "strategy": "sequence",
        "tools": [
          "shellcheck"
        ]
      },
      "onSave": {
        "strategy": "sequence",
        "tools": [
          "shellcheck"
        ]
      }
    }
  ],
  //|-> Powershell
  "powershell.codeFormatting.autoCorrectAliases": true,
  "powershell.codeFormatting.trimWhitespaceAroundPipe": true,
  "powershell.codeFormatting.useConstantStrings": true,
  "powershell.codeFormatting.useCorrectCasing": true,
  "powershell.codeFormatting.whitespaceBetweenParameters": true,
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.integratedConsole.focusConsoleOnExecute": false,
  "powershell.integratedConsole.suppressStartupBanner": true,
  "powershell.integratedConsole.forceClearScrollbackBuffer": true,
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell",
    "editor.renderControlCharacters": true,
    "editor.renderWhitespace": "all",
    "editor.tabCompletion": "on",
    "files.autoGuessEncoding": true,
    "files.encoding": "utf8bom",
    "files.trimTrailingWhitespace": true
  },
  "[properties]": {
    "editor.defaultFormatter": "yy0931.gitconfig-lsp"
  },
  "[ruby]": {
    // "editor.defaultFormatter": "LoranKloeze.ruby-rubocop-revived",
  },
  "rubyLsp.enableExperimentalFeatures": true,
  // "rubyLsp.rubyExecutablePath": "c:\\Tools\\ruby33\\bin\\ruby.exe",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.check.command": "clippy",
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "[scss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[sql]": {
    "editor.defaultFormatter": "adpyke.vscode-sql-formatter",
    // "editor.defaultFormatter": "ms-mssql.mssql"
  },
  "[svg]": {
    // "editor.defaultFormatter": "jock.svg"
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  },
  "[typescript]": {
    // "editor.defaultFormatter": "denoland.vscode-deno"
  },
  // "typescript.inlayHints.parameterNames.enabled": "all",
  "tailwindCSS.includeLanguages": {
    "plaintext": "html"
  },
  "[typst]": {
    // "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
    "editor.defaultFormatter": "myriad-dreamin.tinymist"
  },
  "[typst-code]": {
    // "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
    "editor.defaultFormatter": "myriad-dreamin.tinymist"
  },
  "[xml]": {
    // "editor.defaultFormatter": "DotJoshJohnson.xml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "bluebrown.yamlfmt"
    // "editor.defaultFormatter": "denoland.vscode-deno"
    // "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "zig.zls.enabled": "on",
  "harper.dialect": "British",
  "harper.excludePatterns": [
    // "*.nix"
  ],
  "harper.linters.NumericRangeEnDash": false,
  "harper.linters.Dashes": false,
  "harper.linters.OxfordComma": false,
  "harper.workspaceDictPath": ".harper-dictionary.txt",
  "spreadjs.ribbonMode": "toolbar",
  //> ====================================================
  //> CSS CONFIGURATION
  //> ====================================================
  "cssvar.files": [
    "./node_modules/open-props/open-props.min.css",
    "assets/styles/variables.css",
    "style.css"
  ],
  "cssvar.ignore": [],
  "cssvar.extensions": [
    "css",
    "postcss",
    "jsx",
    "tsx"
  ],
  //> ====================================================
  //> INTELLISENSE & CODE ASSISTANCE
  //> ====================================================
  "chat.tools.terminal.autoApprove": {
    "nix": true,
    "zig": true,
    "command": true,
    "printf": true,
    "cksum": true,
    "awk": true
  },
  "chat.viewSessions.orientation": "stacked",
  "chat.experimental.stickyScroll.enabled": false,
  "codeium.disableSupercomplete": true,
  "codeium.enableConfig": {
    "*": true,
    "nix": true,
    "jsonc": true,
    "just": true,
    "markdown": true,
    "typst": true,
    "cypher": true
  },
  "codeium.enableSearch": true,
  "continue.disableQuickFix": true,
  "continue.enableTabAutocomplete": true,
  "continue.showInlineTip": false,
  "continue.telemetryEnabled": false,
  "diffEditor.codeLens": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "geminicodeassist.inlineSuggestions.enableAuto": true,
  "geminicodeassist.updateChannel": "Insiders",
  "geminicodeassist.chat.defaultCodeBlockDisplay": "Expanded",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "nix": true,
    "shellscript": true,
    "rust": false,
    "powershell": false
  },
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.nextEditSuggestions.eagerness": "low",
  "lldb.suppressUpdateNotifications": true,
  "lldb.showDisassembly": "auto",
  "lldb.dereferencePointers": true,
  "lldb.consoleMode": "commands",
  //> ====================================================
  //> MARKDOWN & DOCUMENTATION
  //> ====================================================
  "markdown.marp.enableHtml": true,
  "markdown.marp.pdf.noteAnnotations": true,
  "markdown.marp.pdf.outlines": "both",
  "markdown.updateLinksOnFileMove.enabled": "always",
  "markdown.validate.enabled": true,
  "markdown-pdf.breaks": true,
  "markdown-pdf.displayHeaderFooter": false,
  "markdown-pdf.format": "Letter",
  "markdown.marp.exportType": "html",
  "markdown.marp.strictPathResolutionDuringExport": true,
  "markdown.preview.typographer": true,
  //> ====================================================
  //> COMMENTS
  //> ====================================================
  "colorful-comments-refreshed.tags": [
    {
      "tag": "@",
      "italic": true,
      "backgroundColor": "#89a25722",
      "color": "#89a257"
    },
    {
      "tag": "~@",
      "italic": true,
      "backgroundColor": "#89a25722",
      "color": "#89a257"
    },
    // {
    //   "tag": "{",
    //   "italic": true,
    //   "backgroundColor": "#2aaaa222",
    //   "color": "#2aaaa2"
    // },
    {
      "tag": "!",
      "backgroundColor": "transparent",
      "color": "#ff0000"
    },
    {
      "tag": "/",
      "italic": true,
      "backgroundColor": "#bd8af41a",
      "color": "#bd8af4"
    },
    {
      "tag": "|",
      "italic": true,
      "color": "hsl(148, 70%, 50%)"
    },
    {
      "tag": "region",
      "italic": true,
      "backgroundColor": "#bd8af41a",
      "color": "#bd8af4"
    },
    {
      "tag": "endregion",
      "italic": true,
      "backgroundColor": "#bd8af41a",
      "color": "#bd8af4"
    },
    {
      "tag": "HELP",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#fed200"
    },
    {
      "tag": "shellcheck",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#fd7b30"
    },
    {
      "tag": "DOC ",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#08c3d4"
    },
    {
      "tag": "USAGE ",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#08c3d4"
    },
    {
      "tag": " http",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#3498DB"
    },
    {
      "tag": " -- ",
      "bold": true,
      "backgroundColor": "transparent",
      "color": "#3498DB"
    },
    {
      "tag": ".",
      "bold": true,
      "backgroundColor": "transparent",
      "color": "#3498DB"
    },
    {
      "tag": "result:",
      "bold": true,
      "backgroundColor": "transparent",
      "color": "#3498DB"
    },
    {
      "tag": "todo",
      "italic": true,
      "underline": true,
      "backgroundColor": "transparent",
      "color": "hsla(27, 90%, 55%, 0.75)"
    },
    {
      "tag": "def",
      "backgroundColor": "transparent",
      "color": "hsla(43, 50%, 50%, 0.95)"
    },
    {
      "tag": "=",
      // "italic": true,
      "backgroundColor": "transparent",
      "color": "hsla(335, 80%, 38%, 0.75)"
    },
    {
      "tag": "+",
      // "italic": true,
      "backgroundColor": "transparent",
      "color": "hsla(335, 80%, 38%, 0.75)"
    },
    {
      "tag": ">",
      "bold": true,
      "italic": true,
      "underline": true,
      "backgroundColor": "transparent",
      "color": "hsla(162, 70%, 30%, 0.95)"
    },
    {
      "tag": "?",
      "bold": true,
      "italic": true,
      "underline": true,
      "backgroundColor": "transparent",
      "color": "hsla(162, 70%, 30%, 0.5)"
    },
    {
      "tag": "╔",
      "italic": true,
      "backgroundColor": "hsla(300,86%,47%, 0.15)",
      "color": "hsl(300,86%,47%)"
    },
    {
      "tag": "║",
      "italic": true,
      "backgroundColor": "hsla(300,86%,47%, 0.15)",
      "color": "hsl(300,86%,47%)"
    },
    {
      "tag": "╠",
      "italic": true,
      "backgroundColor": "hsla(300,86%,47%, 0.15)",
      "color": "hsl(300,86%,47%)"
    },
    {
      "tag": "╚",
      "italic": true,
      "backgroundColor": "hsla(300,86%,47%, 0.15)",
      "color": "hsl(300,86%,47%)"
    }
  ],
  "render-special-chars.include": [
    "0000-0008", // Control characters (NULL to BACKSPACE)
    "000B", // Vertical Tab
    "000C", // Form Feed
    "000E-001F", // Control characters (SHIFT OUT to INFORMATION SEPARATOR ONE)
    "007F-009F", // Control characters (DELETE to APPLICATION PROGRAM COMMAND)
    "00A0-4DFF", // Latin-1 Supplement to Hangul Compatibility Jamo
    "A000-10FFFF" // Yi Syllables to Plane 16 (Supplementary Private Use Area-B)
  ],
  "render-special-chars.except": [
    "0009", // TAB
    "000A", // LF
    "000D", // CR
    "0020-007E", // Printable BASIC ASCII
    "3105-3129", // Bopomofo (ㄅ~ㄦ)
    "4E00-9FFF", // CJK Unified Ideographs
    "：；，、。？！〜（）〈〉《》【】「」『』─" // Commonly used special characters
  ],
  "render-special-chars.position": "before",
  "render-special-chars.border": "1px solid; border-radius: 2px;",
  // "render-special-chars.borderColor": "",
  // "render-special-chars.color": "",
  // "render-special-chars.backgroundColor": "",
  "render-special-chars.excludedSchemes": [
    "output",
    "debug",
    "git"
  ],
  "render-special-chars.updateDelay": 500,
  //> ====================================================
  //> MINIMAP AND LINE INDICATORS
  //> ====================================================
  "editor.minimap.size": "fill",
  "editor.minimap.enabled": true,
  "LWI.breakpoints": [
    {
      "color": "rgb(0, 255, 0, 0.6)",
      "column": 54
    },
    {
      "color": "rgb(244, 180, 0,0.6)",
      "column": 68
    },
    {
      "color": "rgb(255, 0, 0, 0.6)",
      "column": 79
    }
  ],
  "LWI.style.fontStyle": "italic",
  "LWI.style.fontWeight": "100",
