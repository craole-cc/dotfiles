{
  //~@ ====================================================
  //~@ TABLE OF CONTENTS                                  .
  //~@ ====================================================
  //TOC Global & Application
  //TOC Workbench & Layout
  //TOC Theme Toggle
  //TOC Typography
  //TOC Editor
  //TOC Files & Explorer
  //TOC Terminal
  //TOC Git
  //TOC Languages (A-Z)
  //TOC Linting
  //TOC Markdown & Docs
  //TOC AI Assistants
  //TOC Spelling & Prose
  //TOC Debugging
  //TOC Environment, Remote & Sync
  //TOC Privacy & Telemetry
  //TOC Misc Extensions
  //TOC Keybindings
  //TOC Visual Aids (comments, whitespace, rulers)
  //TOC Colours Overrides
  //TOC Icon Overrides
  //~@ ====================================================
  //~@ GLOBAL & APPLICATION                               .
  //~@ ====================================================
  //|=> Global Defaults (apply to every file and language)
  "files.eol": "\n",
  //|=> Identity & Updates
  "license.author": "Craig 'Craole' Cole",
  "license.default": "mit",
  "update.mode": "manual",
  //|=> Window
  "security.workspace.trust.untrustedFiles": "open",
  "window.customMenuBarAltFocus": true,
  "window.customTitleBarVisibility": "auto",
  "window.menuBarVisibility": "toggle",
  "window.restoreFullscreen": true,
  "window.titleBarStyle": "native",
  "window.zoomPerWindow": true,
  //~@ ====================================================
  //~@ WORKBENCH & LAYOUT                                 .
  //~@ ====================================================
  //|=> Layout
  "workbench.activityBar.location": "default",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.sideBar.location": "right",
  "workbench.statusBar.visible": true,
  "breadcrumbs.enabled": true,
  //|=> Startup & Editor Tabs
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.revealIfOpen": true,
  "workbench.editor.showTabs": "multiple",
  "workbench.startupEditor": "none",
  //|=> Palette & Quick Open
  "workbench.commandPalette.preserveInput": true,
  "workbench.quickOpen.preserveInput": true,
  //|=> Misc
  "workbench.experimental.share.enabled": true,
  "workbench.tree.enableStickyScroll": false,
  "extensions.ignoreRecommendations": true,
  "workbench.editor.useModal": "off",
  //~@ ====================================================
  //~@ THEME TOGGLE                                       .
  //~@ ====================================================
  //|=> Themes
  "window.autoDetectColorScheme": false,
  "window.autoDetectHighContrast": false,
  "workbench.colorTheme": "Dynamic Base16 DankShell",
  "workbench.preferredDarkColorTheme": "Catppuccin Frappé",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "el-vsc-v1-icons",
  //|=> Semantic Highlighting (switch only; colour rules live in section 20)
  "editor.semanticHighlighting.enabled": true,
  //~@ ====================================================
  //~@ TYPOGRAPHY                                         .
  //~@ ====================================================
  //|=> Editor
  "editor.fontFamily": "'Lilex Nerd Font', 'Maple Mono NF', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 18,
  "editor.fontWeight": 500,
  "editor.letterSpacing": 0,
  "editor.lineHeight": 2,
  //|=> Terminal
  "terminal.integrated.fontFamily": "'Maple Mono NF', 'Lilex Nerd Font', monospace",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 18,
  "terminal.integrated.fontWeight": 500,
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.lineHeight": 1.2,
  //~@ ====================================================
  //~@ EDITOR                                             .
  //~@ ====================================================
  //|=> Indentation & Wrapping
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,
  //|=> Formatting
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "diffEditor.ignoreTrimWhitespace": false,
  //|=> Display
  "editor.folding": true,
  "editor.glyphMargin": true,
  "editor.lineNumbers": "on",
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "gutter",
  "editor.renderWhitespace": "all",
  "editor.scrollbar.horizontal": "auto",
  "editor.scrollbar.vertical": "auto",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "diffEditor.codeLens": true,
  //|=> Minimap
  "editor.minimap.enabled": true,
  "editor.minimap.size": "fill",
  //|=> Brackets & Guides
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": "active",
  "editor.matchBrackets": false,
  //|=> Highlighting
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  //|=> Cursor & Scrolling
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.mouseWheelZoom": true,
  "editor.smoothScrolling": true,
  //|=> Sticky Scroll
  "editor.stickyScroll.defaultModel": "indentationModel",
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.scrollWithEditor": false,
  //|=> Suggestions & Hints
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.suggestSelection": "recentlyUsedByPrefix",
  //|=> Misc
  "editor.accessibilitySupport": "off",
  "editor.linkedEditing": true,
  //~@ ====================================================
  //~@ FILES & EXPLORER                                   .
  //~@ ====================================================
  //|=> Saving & Line Endings
  "files.autoSave": "onFocusChange",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  //|=> Explorer
  "explorer.compactFolders": false,
  "explorer.excludeGitIgnore": false,
  //|=> Visibility
  // Only the built-in defaults are listed; every other `false` entry was a no-op and was removed.
  "files.exclude": {
    "**/.DS_Store": false,
    "**/.git": false,
    "**/.hg": false,
    "**/.svn": false,
    "**/Thumbs.db": false
  },
  //|=> File Watcher
  // FIXME: these globs contain stray spaces ("/* *", "* cache") and likely don't match anything.
  "files.watcherExclude": {
    "**/.local/* *": true,
    "**/.vscode-server-insiders/* *": true,
    "**/* cache/* *": true,
    "**/.trunk/*actions/": true,
    "**/.trunk/*logs/": true,
    "**/.trunk/*notifications/": true,
    "**/.trunk/*out/": true,
    "**/.trunk/*plugins/": true
  },
  //|=> Language Associations
  "files.associations": {
    //|=> Config & dotfiles
    ".bash*": "shellscript",
    ".dotsrc": "coffeescript",
    ".editorconfig": "ini",
    ".env": "env",
    ".env*": "dotenv",
    ".sqruff": "properties",
    "**/*.conf": "ini",
    "**/conf*/{fuzzel,ghostty,mpv,hyprland}/*": "ini",
    "**/conf*/{raffi}/*": "yaml",
    "*.Xresources": "xdefaults",
    "*envrc": "shellscript",
    "*gitignore": "ignore",
    "*ignore": "ignore",
    "*shellcheckrc": "shellscript",
    "editorconfig": "ini",
    "flake.lock": "json",
    "i3/*.conf": "i3",
    "i3/config": "i3",
    "lesskey": "lesskey",
    "mise.lock": "toml",
    "polybar/*.conf": "ini",
    "polybar/config": "ini",
    //|=> Languages
    "*.bash": "shellscript",
    "*.css": "css",
    "*.erb": "ruby",
    "*.ft": "rust",
    "*.gs": "javascript",
    "*.init": "shellscript",
    "*.nix": "nix",
    "*.nu": "nushell",
    "*.rs": "rust",
    "*.sh": "shellscript",
    "*.typ": "typst",
    "Gemfile": "ruby",
    //|=> Templates & data
    "*.bbmodel": "json",
    "*.ejs": "html",
    "*.emu": "html",
    "*.hbs": "html",
    "*.layout": "json",
    "*.log": "log",
    "*.rasi": "css",
    "*.sublime-snippet": "xml",
    //|=> Docs
    "LICENSE": "txt",
    "LICENSE-MIT": "txt",
    "README": "markdown"
  },
  //|=> Custom Editors (file type -> viewer)
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.ui": "default",
    "*.db": "default",
    "*.pdf": "pdf.view",
    "*.qrc": "qt-core.qrcEditor",
    "*.tsv": "csvViewer.csvEditor",
    "*.xlsx": "csvViewer.csvEditor"
  },
  //~@ ====================================================
  //~@ TERMINAL                                           .
  //~@ ====================================================
  //|=> Behaviour
  "terminal.integrated.allowMnemonics": true,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.terminal.copySelection"
  ],
  "terminal.integrated.confirmOnExit": "never",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.enableImages": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.hideOnStartup": "whenEmpty",
  "terminal.integrated.mouseWheelZoom": false,
  "terminal.integrated.rightClickBehavior": "copyPaste",
  //|=> Appearance
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.tabs.location": "right",
  //|=> Profiles (Windows)
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "NixOS (WSL)": {
      "path": "${env:windir}\\System32\\wsl.exe",
      "args": [
        "-d",
        "NixOS"
      ]
    },
    "Git Bash": {
      "source": "Git Bash"
    },
    "PowerShell": {
      "source": "PowerShell",
      // "path": "${env:ProgramFiles}\\PowerShell\\7\\pwsh.exe",
      "args": [
        "-NoExit",
        "-Command",
        "& { $env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User') }"
      ],
      "icon": "terminal-powershell"
    },
    "Windows PowerShell": {
      "path": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoExit",
        "-Command",
        "& { $env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User') }"
      ],
      "icon": "terminal-powershell"
    },
    "Nushell": {
      "path": "${env:USERPROFILE}\\AppData\\Local\\Programs\\nu\\bin\\nu.exe"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    }
  },
  //~@ ====================================================
  //~@ 8. GIT                                             .
  //~@ ====================================================
  "git.enabled": true,
  "git.autofetch": true,
  "git.autoStash": true,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "git.rebaseWhenSync": true,
  //|=> Confirmations & Safety
  "git.allowForcePush": true,
  "git.confirmForcePush": false,
  "git.confirmSync": false,
  "git.ignoreRebaseWarning": true,
  //~@ ====================================================
  //~@ LANGUAGES (A-Z)                                    .
  //~@ ====================================================
  //|=> Cypher
  "[cypher]": {
    // "editor.defaultFormatter": "neo4j-extensions.neo4j-for-vscode",
    "editor.semanticHighlighting.enabled": true
  },
  //|=> CSS / SCSS / Tailwind
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[scss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "cssvar.files": [
    "./node_modules/open-props/open-props.min.css",
    "assets/styles/variables.css",
    "style.css"
  ],
  "cssvar.ignore": [],
  "cssvar.extensions": [
    "css",
    "postcss",
    "jsx",
    "tsx"
  ],
  "tailwindCSS.includeLanguages": {
    "plaintext": "html"
  },
  //|=> Dotenv
  "[dotenv]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  //|=> Docker
  // "[dockercompose]": { "editor.defaultFormatter": "bluebrown.yamlfmt" },
  // "[dockerfile]":    { "editor.defaultFormatter": "ms-azuretools.vscode-docker" },
  //|=> GitHub Actions
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  //|=> HTML / JavaScript
  "[html]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  //|=> INI
  "[ini]": {
    "editor.defaultFormatter": "lkrms.inifmt"
  },
  //|=> JSON / JSONC
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always"
    },
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always"
    },
    "editor.formatOnSave": true
  },
  "json.schemas": [
    {
      "fileMatch": [
        "**/*.json",
        "**/*.jsonc"
      ],
      "schema": {
        "allowTrailingCommas": true
      }
    }
  ],
  // NOTE: schema download is disabled, so the trusted-domains list below has no effect unless you re-enable it.
  "json.schemaDownload.enable": false,
  "json.schemaDownload.trustedDomains": {
    "https://biomejs.dev": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://dprint.dev": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com/catppuccin/vscode/catppuccin-vsc-v3.19.0/packages/catppuccin-vsc/schemas/colorOverrides.schema.json": true,
    "https://raw.githubusercontent.com/catppuccin/vscode/catppuccin-vsc-v3.19.0/packages/catppuccin-vsc/schemas/customUIColors.schema.json": true,
    "https://raw.githubusercontent.com/DavidAnson/markdownlint/v0.40.0/schema/markdownlint-config-schema.json": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  },
  //|=> Just
  // "vscode-just.useSingleTerminal": true,
  // "vscode-just.formatOnSave": true,
  // "vscode-just.justPath": "C:\\\\Users\\\\Administrator\\\\scoop\\\\shims\\\\just.exe",
  //|=> Markdown  (see also section 11)
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  //|=> Nix
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnSave": true
  },
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "alejandra",
          "-q",
          "-"
          //   "sh",
          //   "-c",
          //   "original=$(cat); fixed=$(printf '%s' \"$original\" | statix fix --stdin); [ -n \"$fixed\" ] || fixed=$original; merged=$(printf '%s' \"$fixed\" | perl -0pe \"$1\"); [ -n \"$merged\" ] || merged=$fixed; printf '%s' \"$merged\" | alejandra -q - || printf '%s' \"$original\"",
          //   "sh",
          //   "1 while s/^([ \\t]*)inherit[ \\t]+([^;(){}#\"\\/*]+);\\n\\1inherit[ \\t]+([^;(){}#\"\\/*]+);/$1inherit $2 $3;/m;"
        ]
      }
    }
  },
  //|=> PowerShell
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell",
    "editor.renderControlCharacters": true,
    "editor.renderWhitespace": "all",
    "editor.tabCompletion": "on",
    "files.autoGuessEncoding": true,
    "files.encoding": "utf8bom",
    "files.trimTrailingWhitespace": true
  },
  "powershell.codeFormatting.autoCorrectAliases": true,
  "powershell.codeFormatting.trimWhitespaceAroundPipe": true,
  "powershell.codeFormatting.useConstantStrings": true,
  "powershell.codeFormatting.useCorrectCasing": true,
  "powershell.codeFormatting.whitespaceBetweenParameters": true,
  "powershell.integratedConsole.focusConsoleOnExecute": false,
  "powershell.integratedConsole.forceClearScrollbackBuffer": true,
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.integratedConsole.suppressStartupBanner": true,
  //|=> Properties (gitconfig / sqruff)
  "[properties]": {
    "editor.defaultFormatter": "yy0931.gitconfig-lsp"
  },
  //|=> Ruby
  // "[ruby]": { "editor.defaultFormatter": "LoranKloeze.ruby-rubocop-revived" },
  "rubyLsp.enableExperimentalFeatures": true,
  // "rubyLsp.rubyExecutablePath": "c:\\Tools\\ruby33\\bin\\ruby.exe",
  //|=> Rust
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.check.command": "clippy",
  //|=> Shell
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "bashIde.explainshellEndpoint": "http://localhost:5000",
  //|=> SQL
  "[sql]": {
    "editor.defaultFormatter": "adpyke.vscode-sql-formatter"
    // "editor.defaultFormatter": "ms-mssql.mssql"
  },
  //|=> TOML
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  },
  //|=> TypeScript
  // "[typescript]": { "editor.defaultFormatter": "denoland.vscode-deno" },
  // "typescript.inlayHints.parameterNames.enabled": "all",
  //|=> Typst
  "[typst]": {
    // "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
    "editor.defaultFormatter": "myriad-dreamin.tinymist"
  },
  "[typst-code]": {
    // "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
    "editor.defaultFormatter": "myriad-dreamin.tinymist"
  },
  //|=> XML / SVG
  // "[xml]": { "editor.defaultFormatter": "DotJoshJohnson.xml" },
  // "[svg]": { "editor.defaultFormatter": "jock.svg" },
  //|=> YAML
  "[yaml]": {
    "editor.defaultFormatter": "bluebrown.yamlfmt"
    // "editor.defaultFormatter": "denoland.vscode-deno"
    // "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  //|=> Zig
  "zig.zls.enabled": "on",
  //~@ ====================================================
  //~@ LINTING                                            .
  //~@ ====================================================
  "lintRunner.tools": {
    "shellcheck": {
      "kind": "diagnostic",
      "command": "shellcheck",
      "args": [
        "--enable=all",
        "--format=gcc",
        "${file}"
      ],
      "successExitCodes": [
        0,
        1
      ],
      "parser": {
        "flags": "gm",
        "pattern": "^.+?:(?<line>\\d+):(?<col>\\d+): (?<severity>error|warning|note): (?<message>.+)$"
      }
    },
    "statix": {
      "kind": "diagnostic",
      "command": "statix",
      "args": [
        "check",
        "--format",
        "errfmt",
        "${file}"
      ],
      "successExitCodes": [
        0,
        1
      ],
      "parser": {
        "flags": "gm",
        "pattern": "^.+?>(?<line>\\d+):(?<col>\\d+):[WE]:(?<code>\\d+):(?<message>.+)$"
      }
    }
  },
  "lintRunner.targets": [
    {
      "name": "Nix",
      "match": {
        "languages": [
          "nix"
        ],
        "files": [
          "**/*.nix"
        ]
      },
      "onOpen": {
        "strategy": "sequence",
        "tools": [
          "statix"
        ]
      },
      "onSave": {
        "strategy": "sequence",
        "tools": [
          "statix"
        ]
      },
      "manual": {
        "strategy": "sequence",
        "tools": [
          "statix"
        ]
      }
    },
    {
      "name": "Shell",
      "match": {
        "languages": [
          "shellscript"
        ]
      },
      "onOpen": {
        "strategy": "sequence",
        "tools": [
          "shellcheck"
        ]
      },
      "onSave": {
        "strategy": "sequence",
        "tools": [
          "shellcheck"
        ]
      }
    }
  ],
  //~@ ====================================================
  //~@ MARKDOWN & DOCS                                    .
  //~@ ====================================================
  "markdown.preview.typographer": true,
  "markdown.updateLinksOnFileMove.enabled": "always",
  "markdown.validate.enabled": true,
  //|=> Marp
  "markdown.marp.enableHtml": true,
  "markdown.marp.exportType": "html",
  "markdown.marp.pdf.noteAnnotations": true,
  "markdown.marp.pdf.outlines": "both",
  "markdown.marp.strictPathResolutionDuringExport": true,
  //|=> Markdown PDF
  "markdown-pdf.breaks": true,
  "markdown-pdf.displayHeaderFooter": false,
  "markdown-pdf.format": "Letter",
  //~@ ====================================================
  //~@ AI ASSISTANCE                                      .
  //~@ ====================================================
  //|=> Copilot
  "github.copilot.enable": {
    "*": true,
    "markdown": false,
    "nix": true,
    "plaintext": false,
    "powershell": false,
    "rust": false,
    "scminput": false,
    "shellscript": true
  },
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.nextEditSuggestions.eagerness": "low",
  "github.copilot.nextEditSuggestions.enabled": true,
  //|=> Chat
  // NOTE: auto-approving awk/nix/zig lets an agent run arbitrary code without a prompt.
  "chat.experimental.stickyScroll.enabled": false,
  "chat.tools.terminal.autoApprove": {
    "awk": true,
    "cksum": true,
    "command": true,
    "nix": true,
    "printf": true,
    "zig": true
  },
  "chat.viewSessions.orientation": "stacked",
  //|=> Codeium
  "codeium.disableSupercomplete": true,
  "codeium.enableConfig": {
    "*": true,
    "cypher": true,
    "jsonc": true,
    "just": true,
    "markdown": true,
    "nix": true,
    "typst": true
  },
  "codeium.enableSearch": true,
  //|=> Continue
  "continue.disableQuickFix": true,
  "continue.enableTabAutocomplete": true,
  "continue.showInlineTip": false,
  //|=> Gemini Code Assisto
  "geminicodeassist.chat.defaultCodeBlockDisplay": "Expanded",
  "geminicodeassist.inlineSuggestions.enableAuto": true,
  "geminicodeassist.updateChannel": "Insiders",
  //~@ ====================================================
  //~@ SPELLING & PROSE                                   .
  //~@ ====================================================
  "harper.dialect": "British",
  "harper.workspaceDictPath": ".harper-dictionary.txt",
  // "harper.diagnosticSeverity": "hint",
  "harper.excludePatterns": [
    // "*.nix"
  ],
  "harper.linters.Dashes": false,
  "harper.linters.NumericRangeEnDash": false,
  "harper.linters.OxfordComma": false,
  "harper.linters.SentenceCapitalization": false,
  "typos.diagnosticSeverity": "Hint",
  //~@ ====================================================
  //~@ DEBUGGING                                          .
  //~@ ====================================================
  "lldb.consoleMode": "commands",
  "lldb.dereferencePointers": true,
  "lldb.showDisassembly": "auto",
  "lldb.suppressUpdateNotifications": true,
  //~@ ====================================================
  //~@ ENVIRONMENT, REMOTE & SYNC                         .
  //~@ ====================================================
  //|=> Environment
  "direnv.restart.automatic": true,
  "dotenv.enableAutocloaking": false,
  //|=> Remote
  "remote.autoForwardPortsSource": "hybrid",
  "remote.SSH.remotePlatform": {
    "dbook.deer-iguana.ts.net": "linux",
    "delle.deer-iguana.ts.net": "linux"
  },
  //|=> Settings Sync
  "settingsSync.ignoredExtensions": [
    "constneo.vscode-nushell-format",
    "jnoortheen.nix-ide",
    "mkhl.direnv",
    "ms-edgedevtools.vscode-edge-devtools",
    "ms-vscode-remote.remote-wsl"
  ],
  //~@ ====================================================
  //~@ PRIVACY & TELEMETRY                                .
  //~@ ====================================================
  "continue.telemetryEnabled": false,
  "redhat.telemetry.enabled": false,
  //~@ ====================================================
  //~@ MISC EXTENSIONS                                    .
  //~@ ====================================================
  //|=> In-editor Browser
  "vs-browser.favourites.list": {
    "http://127.0.0.1:3000": "http://127.0.0.1:3000",
    "http://localhost": "http://localhost"
  },
  "vs-browser.link.enabled": true,
  "vs-browser.link.openWith": "ask",
  "vs-browser.localProxyServer.cookieDomainRewrite": true,
  "vs-browser.localProxyServer.enabled": true,
  "vs-browser.localProxyServer.forceLocation": true,
  "vs-browser.reload.autoReloadDurationEnabled": false,
  "vs-browser.reload.autoReloadDurationTime": 15000,
  "vs-browser.reload.onSave": false,
  "vs-browser.url": "http://127.0.0.1:3000",
  //|=> RSS
  "rss.accounts": {
    "fb0e47b0-9982-11ef-a698-3778cde2492f": {
      "name": "Default",
      "type": "local",
      "feeds": []
    }
  },
  //|=> SpreadJS
  "spreadjs.ribbonMode": "toolbar",
  //~@ ====================================================
  //~@ KEYBINDINGS                                        .
  //~@ ====================================================
  "vscode-default-keybindings.windowsKeybindings": true,
  //~@ ====================================================
  //~@ VISUAL AIDS                                        .
  //~@ ====================================================
  //|=> Line-Width Indicators (LWI)
  "LWI.breakpoints": [
    {
      "color": "rgb(0, 255, 0, 0.6)",
      "column": 54
    },
    {
      "color": "rgb(244, 180, 0,0.6)",
      "column": 68
    },
    {
      "color": "rgb(255, 0, 0, 0.6)",
      "column": 79
    }
  ],
  "LWI.style.fontStyle": "italic",
  "LWI.style.fontWeight": "100",
  //|=> Render Special Characters
  "render-special-chars.border": "1px solid; border-radius: 2px;",
  "render-special-chars.position": "before",
  "render-special-chars.updateDelay": 500,
  // "render-special-chars.backgroundColor": "",
  // "render-special-chars.borderColor": "",
  // "render-special-chars.color": "",
  "render-special-chars.excludedSchemes": [
    "output",
    "debug",
    "git"
  ],
  "render-special-chars.include": [
    "0000-0008", // Control characters (NULL to BACKSPACE)
    "000B", // Vertical Tab
    "000C", // Form Feed
    "000E-001F", // Control characters (SHIFT OUT to INFORMATION SEPARATOR ONE)
    "007F-009F", // Control characters (DELETE to APPLICATION PROGRAM COMMAND)
    "00A0-4DFF", // Latin-1 Supplement to Hangul Compatibility Jamo
    "A000-10FFFF" // Yi Syllables to Plane 16 (Supplementary Private Use Area-B)
  ],
  "render-special-chars.except": [
    "0009", // TAB
    "000A", // LF
    "000D", // CR
    "0020-007E", // Printable BASIC ASCII
    "3105-3129", // Bopomofo
    "4E00-9FFF", // CJK Unified Ideographs
    "：；，、。？！〜（）〈〉《》【】「」『』─" // Commonly used special characters
  ],
  //|=> Colourful Comments
  "colorful-comments-refreshed.tags": [
    //|=> Core markers
    {
      "tag": "@",
      "italic": true,
      "backgroundColor": "#89a25722",
      "color": "#89a257"
    },
    {
      "tag": "~@",
      "italic": true,
      "backgroundColor": "#89a25722",
      "color": "#89a257"
    },
    // { "tag": "{", "italic": true, "backgroundColor": "#2aaaa222", "color": "#2aaaa2" },
    {
      "tag": "!",
      "backgroundColor": "transparent",
      "color": "#ff0000"
    },
    {
      "tag": "/",
      "italic": true,
      "backgroundColor": "#bd8af41a",
      "color": "#bd8af4"
    },
    {
      "tag": "|",
      "italic": true,
      "color": "hsl(148, 70%, 50%)"
    },
    {
      "tag": "region",
      "italic": true,
      "backgroundColor": "#bd8af41a",
      "color": "#bd8af4"
    },
    {
      "tag": "endregion",
      "italic": true,
      "backgroundColor": "#bd8af41a",
      "color": "#bd8af4"
    },
    //|=> Keywords
    {
      "tag": "HELP",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#fed200"
    },
    {
      "tag": "shellcheck",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#fd7b30"
    },
    {
      "tag": "DOC ",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#08c3d4"
    },
    {
      "tag": "TOC ",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#08c3d4"
    },
    {
      "tag": "USAGE ",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#08c3d4"
    },
    {
      "tag": " http",
      "italic": true,
      "backgroundColor": "transparent",
      "color": "#3498DB"
    },
    {
      "tag": " -- ",
      "bold": true,
      "backgroundColor": "transparent",
      "color": "#3498DB"
    },
    {
      "tag": ".",
      "bold": true,
      "backgroundColor": "transparent",
      "color": "#3498DB"
    },
    {
      "tag": "result:",
      "bold": true,
      "backgroundColor": "transparent",
      "color": "#3498DB"
    },
    {
      "tag": "todo",
      "italic": true,
      "underline": true,
      "backgroundColor": "transparent",
      "color": "hsla(27, 90%, 55%, 0.75)"
    },
    {
      "tag": "def",
      "backgroundColor": "transparent",
      "color": "hsla(43, 50%, 50%, 0.95)"
    },
    //|=> Symbols
    {
      "tag": "=",
      "backgroundColor": "transparent",
      "color": "hsla(335, 80%, 38%, 0.75)"
    },
    {
      "tag": "+",
      "backgroundColor": "transparent",
      "color": "hsla(335, 80%, 38%, 0.75)"
    },
    {
      "tag": ">",
      "bold": true,
      "italic": true,
      "underline": true,
      "backgroundColor": "transparent",
      "color": "hsla(162, 70%, 30%, 0.95)"
    },
    {
      "tag": "?",
      "bold": true,
      "italic": true,
      "underline": true,
      "backgroundColor": "transparent",
      "color": "hsla(162, 70%, 30%, 0.5)"
    },
    //|=> Box drawing
    {
      "tag": "╔",
      "italic": true,
      "backgroundColor": "hsla(300,86%,47%, 0.15)",
      "color": "hsl(300,86%,47%)"
    },
    {
      "tag": "║",
      "italic": true,
      "backgroundColor": "hsla(300,86%,47%, 0.15)",
      "color": "hsl(300,86%,47%)"
    },
    {
      "tag": "╠",
      "italic": true,
      "backgroundColor": "hsla(300,86%,47%, 0.15)",
      "color": "hsl(300,86%,47%)"
    },
    {
      "tag": "╚",
      "italic": true,
      "backgroundColor": "hsla(300,86%,47%, 0.15)",
      "color": "hsl(300,86%,47%)"
    }
  ],
  //~@ ====================================================
  //~@ COLOUR OVERRIDES                                   .
  //~@ ====================================================
  //|=> Semantic Token Rules
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "*.static": {
        "italic": true
      },
      "interface": {
        "italic": true
      },
      "keyword": {
        "italic": true
      },
      "selfParameter": {
        "italic": true
      }
    }
  },
  //|=> TextMate Token Overrides
  "editor.tokenColorCustomizations": {
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#000"
          }
        }
      ]
    },
    "[*Dark*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    },
    "textMateRules": [
      {
        "scope": [
          "variable.other.typst",
          "meta.function-call.typst",
          "entity.name.function.typst",
          "variable.parameter.typst",
          "punctuation.definition.variable.typst",
          "meta.interpolation.typst",
          "entity.name.tag.typst",
          "support.function.typst",
          "keyword.other.typst"
        ],
        "settings": {
          "fontStyle": "italic bold"
        }
      },
      {
        "scope": [
          "comment",
          "emphasis",
          "entity.name.method.js",
          "entity.name.class.js",
          "entity.name.tag.doctype",
          "entity.other.attribute-name",
          "entity.other.attribute-name.tag.jade",
          "entity.other.attribute-name.tag.pug",
          "keyword",
          "keyword.control",
          "keyword.operator.comparison",
          "keyword.control.flow.js",
          "keyword.control.flow.ts",
          "keyword.control.flow.tsx",
          "keyword.control.ruby",
          "keyword.control.module.ruby",
          "keyword.control.class.ruby",
          "keyword.control.def.ruby",
          "keyword.control.loop.js",
          "keyword.control.loop.ts",
          "keyword.control.import.js",
          "keyword.control.import.ts",
          "keyword.control.import.tsx",
          "keyword.control.from.js",
          "keyword.control.from.ts",
          "keyword.control.from.tsx",
          "keyword.operator.expression.delete",
          "keyword.operator.new",
          "keyword.operator.expression",
          "keyword.operator.cast",
          "keyword.operator.relational",
          "keyword.operator.sizeof",
          "keyword.operator.logical.python",
          "italic",
          "markup.changed",
          "markup.deleted.diff",
          "markup.italic",
          "markup.italic.markdown",
          "markup.quote",
          "markup.quote.markdown",
          "meta.decorator punctuation.decorator",
          "meta.delimiter.period",
          "meta.diff.header.git",
          "meta.diff.header.from-file",
          "meta.diff.header.to-file",
          "markup.inserted.diff",
          "meta.class meta.method.declaration meta.var.expr storage.type.js",
          "meta.tag.sgml.doctype",
          "meta.selector",
          "punctuation.accessor",
          "punctuation.definition.comment",
          "punctuation.definition.template-expression.begin",
          "punctuation.definition.template-expression.end",
          "punctuation.section.embedded",
          "quote",
          "source.js constant.other.object.key.js string.unquoted.label.js",
          "source.go keyword.package.go",
          "source.go keyword.import.go",
          "source.go keyword.function.go",
          "source.go keyword.type.go",
          "source.go keyword.struct.go",
          "source.go keyword.interface.go",
          "source.go keyword.const.go",
          "source.go keyword.var.go",
          "source.go keyword.map.go",
          "source.go keyword.channel.go",
          "source.go keyword.control.go",
          "storage",
          "storage.type",
          "storage.modifier",
          "storage.type.property.js",
          "storage.type.property.ts",
          "storage.type.property.tsx",
          "tag.decorator.js entity.name.tag.js",
          "tag.decorator.js",
          "text.html.basic entity.other.attribute-name.html",
          "text.html.basic entity.other.attribute-name",
          "variable.language",
          "variable.other.object.property"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  //|=> UI Colour Overrides
  "workbench.colorCustomizations": {},
