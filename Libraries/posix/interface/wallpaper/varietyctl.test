#!/bin/sh
# Run with sh Libraries/posix/tasks/varietyctl.test; TEST_SHELL selects another sh.
set -eu

test_dir=$(CDPATH='' cd -P "$(dirname "$0")" && pwd)
controller=${VARIETYCTL_TEST_TARGET:-$test_dir/../interface/wallpaper/varietyctl}
test_shell=${TEST_SHELL:-$(command -v sh)}
work=$(mktemp -d "${TMPDIR:-/tmp}/varietyctl-test.XXXXXXXX")
export work
cleanup() {
  if [ -n "${private_root:-}" ]; then
    rm -f "$private_root/set.lock"
    rmdir "$private_root" 2> /dev/null || :
  fi
  [ -z "${foreign_pid:-}" ] || kill "$foreign_pid" 2> /dev/null || :
  for record in "$work"/pids/*; do
    [ -f "$record" ] || continue
    read -r process < "$record" || continue
    kill "$process" 2> /dev/null || :
  done
  rm -rf "$work"
}
trap cleanup 0
trap 'exit 1' HUP INT TERM
mkdir "$work/saved" "$work/bin" "$work/pids" "$work/images" "$work/runtime" "$work/only-variety"
# A closed PATH prevents the tests from touching any real wallpaper service.
for utility in cat cmp id sleep mkdir rmdir rm sed awk od xargs sh flock setsid jaq jq rg chmod cp mv env ln readlink stat ls; do
  utility_path=$(command -v "$utility" || :)
  [ -z "$utility_path" ] || ln -s "$utility_path" "$work/bin/$utility"
done
export XDG_RUNTIME_DIR="$work/runtime"
export WALLPAPER_BACKEND=dms
test_uid=$(id -u)
export test_uid
unset VARIETYCTL_BACKEND VARIETYCTL_POSIX_ONLY VARIETYCTL_DEBUG VARIETYCTL_LOCKSCREEN_LINK VARIETYCTL_SWAYBG_SETTLE
export WAYLAND_DISPLAY=wayland-test
export XDG_CURRENT_DESKTOP=Hyprland

check() {
  if "$@"; then
    printf 'ok: %s\n' "$*"
  else
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
  fi
}
cat > "$work/bin/variety" << 'STUB'
#!/bin/sh
# Models Variety's argv dispatch only; flags were checked against --help.
if [ "${VARIETYCTL_CAPTURE_BACKEND:-0}" = 1 ]; then
  printf '%s\n' "$VARIETYCTL_BACKEND"
else
  printf '%s\n' "$@"
fi
STUB
chmod +x "$work/bin/variety"
cp "$work/bin/variety" "$work/only-variety/variety"
# Only Variety is available: no dependency resolution may execute other tools.
for action in next previous love preferences; do
  case "$action" in
    next) expected=--next ;;
    previous) expected=--previous ;;
    love) expected=--favorite ;;
    preferences) expected=--show-preferences ;;
  esac
  actual=$(PATH="$work/only-variety" "$test_shell" "$controller" "$action")
  check test "$actual" = "$expected"
done
cat > "$work/bin/dms" << 'STUB'
#!/bin/sh
# Models DMS 1.6.3 wallpaper IPC, including successful IPC with ERROR text.
printf 'dms %s\n' "$*" >> "$work/backend-calls"
case "$*" in
  'ipc call wallpaper get')
    [ "${DMS_FAIL:-0}" != 1 ] || exit 1
    if [ "${DMS_GET_TEXT_FAIL:-0}" = 1 ]; then printf '%s\n' 'ERROR: No wallpaper'; exit 0; fi
    if [ "${DMS_PER_MONITOR:-0}" = 1 ]; then
      printf '%s\n' 'ERROR: Per-monitor mode enabled. Use getFor(screenName) instead.'
      exit 0
    fi
    exec cat "$work/current"
    ;;
  'ipc call wallpaper getFor '*)
    [ "${DMS_FAIL:-0}" != 1 ] || exit 1
    if [ "${DMS_GET_TEXT_FAIL:-0}" = 1 ]; then printf '%s\n' 'ERROR: No wallpaper'; exit 0; fi
    exec cat "$work/current"
    ;;
  *)
    [ "${DMS_FAIL:-0}" != 1 ] || exit 1
    if [ "${DMS_TEXT_FAIL:-0}" = 1 ]; then
      printf '%s\n' 'ERROR: Failed to set wallpaper'
      exit 0
    fi
    if [ "$4" = setFor ]; then
      printf '%s\n' "$6" > "$work/current"
    else
      if [ "${DMS_PER_MONITOR:-0}" = 1 ]; then
        printf '%s\n' 'ERROR: Per-monitor mode enabled. Use setFor(screenName, path) instead.'
        exit 0
      fi
      printf '%s\n' "$5" > "$work/current"
    fi
    ;;

esac
STUB
chmod +x "$work/bin/dms"
PATH="$work/bin"
export PATH
for name in 'space name.jpg' "single'quote.jpg" 'double"quote.jpg' '-leading.jpg' 'embedded
newline.jpg' 'trailing-newline
' 'percent%hash#?.jpg' 'utf8-é.jpg'; do
  : > "$work/images/$name"
  for posix in 0 1; do
    export VARIETYCTL_POSIX_ONLY=$posix
    (cd "$work/images" && "$test_shell" "$controller" set "$name" manual "$name" scaled)
    printf '%s\n' "$work/images/$name" > "$work/expected"
    "$test_shell" "$controller" get > "$work/actual"
    check cmp "$work/expected" "$work/actual"
  done
done

cat > "$work/bin/hyprctl" << 'STUB'
#!/bin/sh
# Models live Hyprland 0.56.2 monitor JSON (array of objects with name)
# and hyprpaper 0.8.4's documented IPC; monitor labels are test fixtures.
printf 'hyprctl %s\n' "$*" >> "$work/backend-calls"
case "$*" in
  'monitors -j')
    [ "${MONITOR_JSON_FAIL:-0}" != 1 ] || exit 1
    printf '%s\n' '[{"name":"DP-1"}]'
    ;;
  monitors) printf '%s\n' 'Monitor DP-1 (ID 0):' ;;
  'hyprpaper listactive')
    # Installed hyprctl 0.56.2, absent hyprpaper endpoint: status 1, this text.
    # Also model a successful transport carrying the same failure text.
    if [ -n "${HYPR_ABSENT_STATUS:-}" ]; then
      printf '%s\n' "error: can't send: failed to connect to hyprpaper (is it running?)"
      exit "$HYPR_ABSENT_STATUS"
    fi
    [ "${HYPR_LIST_FAIL:-0}" != 1 ] || exit 1
    [ "${HYPR_EMPTY:-0}" = 1 ] || printf 'DP-1: %s\n' "$work/images/space name.jpg"
    ;;
  'hyprpaper wallpaper '*)
    printf '%s\n' "$3" > "$work/hypr-argument"
    [ "${HYPR_EXIT_FAIL:-0}" != 1 ] || exit 1
    if [ "${HYPR_FAIL:-0}" = 1 ]; then printf '%s\n' 'error: rejected'; else printf '%s\n' ok; fi
    ;;
  *) exit 2 ;;
esac
STUB
cat > "$work/bin/niri" << 'STUB'
#!/bin/sh
# Models niri's source-verified Outputs map and CLI JSON serialisation.
# Local niri IPC is unverified because niri is not installed on this host.
printf 'niri %s\n' "$*" >> "$work/backend-calls"
# Text fixture models upstream niri src/ipc/client.rs print_output():
# Output "make model serial" (connector), followed by indented properties.
# https://github.com/niri-wm/niri/blob/main/src/ipc/client.rs
# Source model only; no installed niri output was available to capture.
if [ "$*" = 'msg outputs' ]; then
  [ "${NIRI_FAIL:-0}" != 1 ] || exit 1
  printf '%s\n' 'Output "Dell Model (Test) Unknown" (DP-2)' '  Current mode: 1920x1080 @ 60.000 Hz' \
    '  Logical position: 0, 0' '' 'Output "Panel Model Unknown" (eDP-1)' '  Disabled'
  exit 0
fi
[ "$*" = 'msg --json outputs' ] || exit 2
[ "${NIRI_FAIL:-0}" != 1 ] || exit 1
if [ "${NIRI_JSON_BAD:-0}" = 1 ]; then
  printf '%s\n' 'not JSON'
else
  printf '%s\n' '{"DP-2":{"name":"DP-2","logical":{"x":0}},"eDP-1":{"name":"eDP-1","logical":{"x":1920}}}'
fi
STUB
cat > "$work/bin/swaybg" << 'STUB'
#!/bin/sh
# Models swaybg argv and process lifetime; never opens a compositor connection.
printf 'swaybg %s\n' "$*" >> "$work/backend-calls"
[ "${SWAY_FAIL:-0}" != 1 ] || exit 1
if [ -n "${SWAY_DIE_AFTER:-}" ]; then sleep "$SWAY_DIE_AFTER"; exit 1; fi
printf '%s\n' "$$" > "$work/pids/$$"
printf '%s\n' "$@" > "$work/sway-arguments"
child=
trap '[ -z "$child" ] || kill "$child" 2>/dev/null; rm -f "$work/pids/$$"; exit 0' TERM INT HUP
while :; do
  sleep 1 &
  child=$!
  wait "$child" || :
done
STUB
cat > "$work/bin/pgrep" << 'STUB'
#!/bin/sh
# Models procps pgrep -u UID -x NAME and its 0/1 match status.
[ "${TEST_NO_SWAY:-0}" != 1 ] || exit 1
[ "$*" = "-u ${TEST_PRIVATE_UID:-$test_uid} -x swaybg" ] || exit 2
found=false
for record in "$work"/pids/*; do
  [ -f "$record" ] || continue
  read -r pid < "$record" || continue
  if kill -0 "$pid" 2>/dev/null; then printf '%s\n' "$pid"; found=true; fi
done
"$found"
STUB
cat > "$work/bin/ps" << 'STUB'
#!/bin/sh
# Models POSIX ps columns, including a foreign owner's process for filtering.
[ "$*" = '-e -o uid= -o pid= -o comm=' ] || exit 2
[ "${TEST_NO_SWAY:-0}" != 1 ] || exit 0
# A different user's swaybg must never be selected or killed.
[ -z "${foreign_pid:-}" ] || printf '%s %s swaybg\n' "$((test_uid + 1))" "$foreign_pid"
for record in "$work"/pids/*; do
  [ -f "$record" ] || continue
  read -r pid < "$record" || continue
  kill -0 "$pid" 2>/dev/null && printf '%s %s swaybg\n' "$test_uid" "$pid"
done
exit 0
STUB
chmod +x "$work/bin/niri" "$work/bin/hyprctl" "$work/bin/swaybg" "$work/bin/pgrep" "$work/bin/ps"

expect_status() {
  expected_status=$1
  shift
  actual_status=0
  "$@" > "$work/stdout" 2> "$work/stderr" || actual_status=$?
  check test "$actual_status" -eq "$expected_status"
}

# Non-swaybg setters must neither create a lock nor wait on a live lock.
for selected in dms hyprpaper; do
  rm -f "$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock"
  VARIETYCTL_BACKEND=$selected "$test_shell" "$controller" set "$work/images/space name.jpg"
  check test ! -e "$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock"
  mkdir "$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock.d"
  printf '%s\n' "$$" > "$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock.d/pid"
  VARIETYCTL_BACKEND=$selected "$test_shell" "$controller" set "$work/images/space name.jpg"
  check test "$(cat "$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock.d/pid")" = "$$"
  rm "$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock.d/pid"
  rmdir "$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock.d"
done

# DMS monitor discovery: JSON, rg without user configuration, then POSIX sed.
export VARIETYCTL_BACKEND=dms DMS_PER_MONITOR=1
for posix in 0 1; do
  export VARIETYCTL_POSIX_ONLY=$posix
  "$test_shell" "$controller" set "$work/images/space name.jpg"
  "$test_shell" "$controller" get > "$work/actual"
  printf '%s\n' "$work/images/space name.jpg" > "$work/expected"
  check cmp "$work/expected" "$work/actual"
done
VARIETYCTL_POSIX_ONLY=0 MONITOR_JSON_FAIL=1 RIPGREP_CONFIG_PATH=/nonexistent \
  "$test_shell" "$controller" set "$work/images/space name.jpg"
unset DMS_PER_MONITOR

# DMS per-monitor retry on niri uses object keys; it never invokes hyprctl.
export XDG_CURRENT_DESKTOP=nIrI VARIETYCTL_BACKEND=dms DMS_PER_MONITOR=1
for posix in 0 1; do
  export VARIETYCTL_POSIX_ONLY=$posix
  : > "$work/backend-calls"
  "$test_shell" "$controller" set "$work/images/space name.jpg"
  "$test_shell" "$controller" get > "$work/actual"
  check cmp "$work/expected" "$work/actual"
  case "$(cat "$work/backend-calls")" in *'setFor DP-2'*'setFor eDP-1'*) : ;; *) exit 1 ;; esac
  while IFS= read -r call; do
    case "$call" in dms* | niri*) : ;; *) exit 1 ;; esac
  done < "$work/backend-calls"
done
VARIETYCTL_POSIX_ONLY=0 NIRI_JSON_BAD=1 expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
export XDG_CURRENT_DESKTOP=Hyprland
unset DMS_PER_MONITOR

# Parser stubs model jaq 3.1.1/jq's shared -er filters for the compositor fixtures.
# Normal discovery tests above exercise the installed parsers against those fixtures.
for utility in jaq jq; do
  if [ -e "$work/bin/$utility" ]; then mv "$work/bin/$utility" "$work/saved/$utility"; fi
done
cat > "$work/bin/jaq" << 'STUB'
#!/bin/sh
parser=${0##*/}
printf '%s\n' "$parser" >>"$work/json-calls"
cat >/dev/null
[ "$parser:${JSON_FAIL_JAQ:-0}" != jaq:1 ] || exit 1
case "$*" in
'-er .[].name') printf '%s\n' DP-1 ;;
'-er keys[]') printf '%s\n' DP-2 eDP-1 ;;
*) exit 2 ;;
esac
STUB
cp "$work/bin/jaq" "$work/bin/jq"
chmod +x "$work/bin/jaq" "$work/bin/jq"
for desktop in Hyprland niri; do
  export XDG_CURRENT_DESKTOP=$desktop DMS_PER_MONITOR=1 VARIETYCTL_POSIX_ONLY=0
  for parser in jaq jq; do
    if [ "$parser" = jq ]; then mv "$work/bin/jaq" "$work/jaq.hidden"; fi
    : > "$work/json-calls"
    : > "$work/backend-calls"
    "$test_shell" "$controller" set "$work/images/space name.jpg"
    "$test_shell" "$controller" get > "$work/$parser-output"
    cp "$work/backend-calls" "$work/$parser-calls"
    case "$(cat "$work/json-calls")" in *"$parser"*) : ;; *) exit 1 ;; esac
    if [ "$parser" = jaq ]; then
      case "$(cat "$work/json-calls")" in *jq*) exit 1 ;; esac
    fi
  done
  mv "$work/jaq.hidden" "$work/bin/jaq"
  check cmp "$work/jaq-output" "$work/jq-output"
  check cmp "$work/jaq-calls" "$work/jq-calls"
  : > "$work/json-calls"
  JSON_FAIL_JAQ=1 "$test_shell" "$controller" set "$work/images/space name.jpg"
  printf '%s\n' jaq jq > "$work/expected-json-calls"
  check cmp "$work/expected-json-calls" "$work/json-calls"
  : > "$work/json-calls"
  VARIETYCTL_POSIX_ONLY=1 "$test_shell" "$controller" set "$work/images/space name.jpg"
  check test ! -s "$work/json-calls"
done
for utility in jaq jq; do
  rm "$work/bin/$utility"
  if [ -e "$work/saved/$utility" ]; then mv "$work/saved/$utility" "$work/bin/$utility"; fi
done
export XDG_CURRENT_DESKTOP=Hyprland
unset DMS_PER_MONITOR

# Both hyprpaper call forms accept only "ok", even if IPC exits zero.
export VARIETYCTL_BACKEND=hyprpaper
for empty in 0 1; do
  export HYPR_EMPTY=$empty
  "$test_shell" "$controller" set "$work/images/space name.jpg" manual original scaled
  if [ "$empty" = 0 ]; then monitor=DP-1; else monitor=; fi
  check test "$(cat "$work/hypr-argument")" = "$monitor, $work/images/space name.jpg, contain"
  export HYPR_FAIL=1
  expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
  unset HYPR_FAIL
  export HYPR_EXIT_FAIL=1
  expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
  unset HYPR_EXIT_FAIL
done
unset HYPR_EMPTY
"$test_shell" "$controller" get > "$work/actual"
check cmp "$work/expected" "$work/actual"
: > "$work/images/comma,.jpg"
expect_status 1 "$test_shell" "$controller" set "$work/images/comma,.jpg"
check test -s "$work/stderr"

# Count the live test instances, waiting briefly for terminated stubs to exit.
alive() {
  alive_count=0
  for record in "$work"/pids/*; do
    [ -f "$record" ] || continue
    read -r pid < "$record" || continue
    if kill -0 "$pid" 2> /dev/null; then alive_count=$((alive_count + 1)); fi
  done
}
settle() { sleep 1; }

# A failing selected backend must never invoke another wallpaper backend.
for posix in 0 1; do
  export VARIETYCTL_POSIX_ONLY=$posix
  for selected in dms hyprpaper swaybg; do
    export VARIETYCTL_BACKEND=$selected
    : > "$work/backend-calls"
    case "$selected" in
      dms) export DMS_FAIL=1 ;;
      hyprpaper) export HYPR_FAIL=1 ;;
      swaybg) export SWAY_FAIL=1 ;;
    esac
    expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
    case "$(cat "$work/stderr")" in
      *"varietyctl: $selected:"*) : ;;
      *)
        printf '%s\n' 'FAIL: failure does not name backend' >&2
        exit 1
        ;;
    esac
    while IFS= read -r call; do
      case "$selected:$call" in
        dms:dms* | 'dms:hyprctl monitors'* | hyprpaper:hyprctl* | swaybg:swaybg*) : ;;
        *)
          printf 'FAIL: another backend invoked: %s\n' "$call" >&2
          exit 1
          ;;
      esac
    done < "$work/backend-calls"
    : > "$work/backend-calls"
    case "$selected" in
      hyprpaper) export HYPR_LIST_FAIL=1 ;;
      swaybg) export TEST_NO_SWAY=1 ;;
    esac
    expect_status 1 "$test_shell" "$controller" get
    while IFS= read -r call; do
      case "$selected:$call" in
        dms:dms* | 'dms:hyprctl monitors'* | hyprpaper:hyprctl* | swaybg:swaybg*) : ;;
        *)
          printf 'FAIL: getter invoked another backend: %s\n' "$call" >&2
          exit 1
          ;;
      esac
    done < "$work/backend-calls"
    unset DMS_FAIL HYPR_FAIL SWAY_FAIL HYPR_LIST_FAIL TEST_NO_SWAY
  done
  # Auto commits to reachable DMS, even if its later setter fails.
  export VARIETYCTL_BACKEND=auto DMS_TEXT_FAIL=1
  : > "$work/backend-calls"
  expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
  while IFS= read -r call; do
    case "$call" in dms* | 'hyprctl monitors'*) : ;; *) exit 1 ;; esac
  done < "$work/backend-calls"
  unset DMS_TEXT_FAIL
  : > "$work/backend-calls"
  DMS_GET_TEXT_FAIL=1 expect_status 1 "$test_shell" "$controller" get
  while IFS= read -r call; do
    case "$call" in dms* | 'hyprctl monitors'*) : ;; *) exit 1 ;; esac
  done < "$work/backend-calls"
  # Auto selects hyprpaper only on Hyprland when DMS is unreachable.
  DMS_FAIL=1 "$test_shell" "$controller" set "$work/images/space name.jpg"
  export DMS_FAIL=1 HYPR_FAIL=1
  expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
  unset DMS_FAIL HYPR_FAIL
  # An absent daemon is not selected, including transport-success error text.
  for absent_status in 1 0; do
    : > "$work/backend-calls"
    DMS_FAIL=1 HYPR_ABSENT_STATUS=$absent_status "$test_shell" "$controller" set "$work/images/space name.jpg"
    case "$(cat "$work/backend-calls")" in *'swaybg '*) : ;; *) exit 1 ;; esac
    case "$(cat "$work/backend-calls")" in *'hyprctl hyprpaper wallpaper '*) exit 1 ;; esac
    check test -s "$work/backend-calls"
  done
  # Reachable hyprpaper with an empty active-image list remains selectable.
  : > "$work/backend-calls"
  DMS_FAIL=1 HYPR_EMPTY=1 "$test_shell" "$controller" set "$work/images/space name.jpg"
  case "$(cat "$work/backend-calls")" in *'hyprctl hyprpaper wallpaper '*) : ;; *) exit 1 ;; esac
  # Other compositors select swaybg when DMS is unreachable, without hyprctl.
  : > "$work/backend-calls"
  XDG_CURRENT_DESKTOP=niri DMS_FAIL=1 "$test_shell" "$controller" set "$work/images/space name.jpg"
  while IFS= read -r call; do
    case "$call" in dms* | swaybg*) : ;; *) exit 1 ;; esac
  done < "$work/backend-calls"
done

# Real /proc cmdline reads exercise NUL decoding, including empty arguments.
export VARIETYCTL_BACKEND=swaybg
sleep 180 &
foreign_pid=$!
export foreign_pid
# Record this sentinel for cleanup too, but exclude it from normal discovery.
for name in 'space name.jpg' "single'quote.jpg" 'double"quote.jpg' '-leading.jpg' 'embedded
newline.jpg' 'trailing-newline
'; do
  for posix in 0 1; do
    export VARIETYCTL_POSIX_ONLY=$posix
    (cd "$work/images" && "$test_shell" "$controller" set "$name" manual original centered)
    settle
    printf '%s\n' "$work/images/$name" > "$work/expected"
    "$test_shell" "$controller" get > "$work/actual.$posix"
    check cmp "$work/expected" "$work/actual.$posix"
    check kill -0 "$foreign_pid"
  done
  check cmp "$work/actual.0" "$work/actual.1"
done
# Include an empty arg before --image and a trailing empty arg in /proc.
for record in "$work"/pids/*; do
  [ ! -f "$record" ] || kill "${record##*/}" 2> /dev/null || :
done
settle
"$work/bin/swaybg" '' --image "$work/images/trailing-newline
" '' &
manual_pid=$!
sleep 1
for posix in 0 1; do
  VARIETYCTL_POSIX_ONLY=$posix "$test_shell" "$controller" get > "$work/actual.$posix"
  check cmp "$work/expected" "$work/actual.$posix"
done
kill "$manual_pid"
wait "$manual_pid" || :

# A ten-call burst must leave one instance, with flock and with mkdir fallback.
# Use the default 0.5 s settle and the 10 s lock wait.
# All ten setters must succeed and leave one surviving process.
for lock_method in flock mkdir; do
  if [ "$lock_method" = mkdir ] && [ -e "$work/bin/flock" ]; then
    mv "$work/bin/flock" "$work/saved/flock"
  fi
  for posix in 0 1; do
    export VARIETYCTL_POSIX_ONLY=$posix
    jobs=
    burst=0
    while [ "$burst" -lt 10 ]; do
      "$test_shell" "$controller" set "$work/images/space name.jpg" &
      jobs="$jobs $!"
      burst=$((burst + 1))
    done
    burst_status=0
    for job in $jobs; do wait "$job" || burst_status=1; done
    check test "$burst_status" -eq 0
    settle
    alive
    check test "$alive_count" -eq 1
    for record in "$work"/pids/*; do [ ! -f "$record" ] || old_pid=${record##*/}; done
    export SWAY_FAIL=1
    expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
    unset SWAY_FAIL
    check kill -0 "$old_pid"
  done
done
if [ -e "$work/saved/flock" ]; then mv "$work/saved/flock" "$work/bin/flock"; fi
kill "$foreign_pid"
wait "$foreign_pid" || :
unset foreign_pid

# Default polling must catch a process that dies after the old 0.1 s check.
for record in "$work"/pids/*; do [ ! -f "$record" ] || old_pid=${record##*/}; done
export VARIETYCTL_BACKEND=swaybg SWAY_DIE_AFTER=0.2
expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
unset SWAY_DIE_AFTER
check kill -0 "$old_pid"
VARIETYCTL_SWAYBG_SETTLE=0.2 "$test_shell" "$controller" set "$work/images/space name.jpg"
VARIETYCTL_SWAYBG_SETTLE=invalid expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
VARIETYCTL_SWAYBG_SETTLE=0 expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"

# Lock-screen writes remain isolated stubs, including KDE 5 fallback.
cat > "$work/bin/gsettings" << 'STUB'
#!/bin/sh
# Models gsettings set/get argv; stores calls without touching dconf.
if [ "$1" = get ]; then printf '%s\n' "'zoom'"; else printf '%s\n' "$@" >> "$work/lock-arguments"; fi
STUB
cat > "$work/bin/kwriteconfig5" << 'STUB'
#!/bin/sh
# Models kwriteconfig key/value argv; no KDE config is written.
printf '%s\n' "$@" >> "$work/lock-arguments"
STUB
chmod +x "$work/bin/gsettings" "$work/bin/kwriteconfig5"
: > "$work/images/URI %?#'\"é
.jpg"
for desktop in gNoMe KDE; do
  : > "$work/lock-arguments"
  XDG_CURRENT_DESKTOP=$desktop "$test_shell" "$controller" set-lockscreen "$work/images/URI %?#'\"é
.jpg" manual original scaled
  check test -s "$work/lock-arguments"
  case "$(cat "$work/lock-arguments")" in
    *"file://$work/images/URI%20%25%3F%23%27%22%C3%A9%0A.jpg"*) : ;;
    *)
      printf '%s\n' 'FAIL: URI encoding' >&2
      exit 1
      ;;
  esac
done
cp "$work/bin/kwriteconfig5" "$work/bin/kwriteconfig6"
XDG_CURRENT_DESKTOP=KDE "$test_shell" "$controller" set-lockscreen "$work/images/space name.jpg"

# Wayland link updates are silent, preserve bytes and never edit locker config.
for desktop in hYpRlAnD NiRi other-wayland; do
  for posix in 0 1; do
    export VARIETYCTL_POSIX_ONLY=$posix
    for name in 'space name.jpg' 'trailing-newline
'; do
      XDG_STATE_HOME="$work/state" XDG_CURRENT_DESKTOP=$desktop \
        "$test_shell" "$controller" set-lockscreen "$work/images/$name" > "$work/stdout"
      check test ! -s "$work/stdout"
      readlink "$work/state/varietyctl/lockscreen" > "$work/actual"
      printf '%s\n' "$work/images/$name" > "$work/expected"
      check cmp "$work/expected" "$work/actual"
    done
    XDG_CURRENT_DESKTOP=$desktop VARIETYCTL_LOCKSCREEN_LINK="$work/custom/link" \
      "$test_shell" "$controller" set-lockscreen "$work/images/space name.jpg"
    check test "$(readlink "$work/custom/link")" = "$work/images/space name.jpg"
    XDG_STATE_HOME='' HOME="$work/testhome" XDG_CURRENT_DESKTOP=$desktop \
      "$test_shell" "$controller" set-lockscreen "$work/images/space name.jpg"
    check test -L "$work/testhome/.local/state/varietyctl/lockscreen"
  done
done
# Model Variety's processed-image cleanup; the original survives and the link follows it.
for posix in 0 1; do
  : > "$work/images/wallpaper-clock-generated.jpg"
  VARIETYCTL_POSIX_ONLY=$posix XDG_CURRENT_DESKTOP=niri WAYLAND_DISPLAY='' \
    VARIETYCTL_LOCKSCREEN_LINK="$work/stable/link" "$test_shell" "$controller" \
    set-lockscreen "$work/images/wallpaper-clock-generated.jpg" refresh "$work/images/space name.jpg" zoom
  rm "$work/images/wallpaper-clock-generated.jpg"
  check test -f "$work/stable/link"
  check test "$(readlink "$work/stable/link")" = "$work/images/space name.jpg"
  (cd "$work/images" && VARIETYCTL_POSIX_ONLY=$posix XDG_CURRENT_DESKTOP=Hyprland WAYLAND_DISPLAY='' \
    VARIETYCTL_LOCKSCREEN_LINK="$work/stable/link" "$test_shell" "$controller" \
    set-lockscreen 'space name.jpg' manual 'utf8-é.jpg')
  check test "$(readlink "$work/stable/link")" = "$work/images/utf8-é.jpg"
done
VARIETYCTL_DEBUG=1 XDG_CURRENT_DESKTOP=GNOME "$test_shell" "$controller" set-lockscreen "$work/images/space name.jpg" 2> "$work/stderr"
case "$(cat "$work/stderr")" in
  *'compatibility write with no effect on stock GNOME Shell'*) : ;;
  *) exit 1 ;;
esac

# Check KDE mode mapping as well as URI encoding.
: > "$work/lock-arguments"
XDG_CURRENT_DESKTOP=KDE "$test_shell" "$controller" set-lockscreen "$work/images/space name.jpg" manual original scaled
case "$(cat "$work/lock-arguments")" in
  *'FillMode
1') : ;;
  *)
    printf '%s\n' 'FAIL: KDE FillMode' >&2
    exit 1
    ;;
esac

# Missing POSIX dependencies must produce a controller error, not exit 127.
export VARIETYCTL_BACKEND=swaybg VARIETYCTL_POSIX_ONLY=1
for missing in ps od awk xargs sh; do
  mv "$work/bin/$missing" "$work/$missing.saved"
  expect_status 1 "$test_shell" "$controller" get
  case "$(cat "$work/stderr")" in
    *"missing required tool: $missing"*) : ;;
    *)
      printf 'FAIL: missing %s diagnostic\n' "$missing" >&2
      exit 1
      ;;
  esac
  mv "$work/$missing.saved" "$work/bin/$missing"
done
mv "$work/bin/sed" "$work/saved/sed"
export VARIETYCTL_BACKEND=dms DMS_PER_MONITOR=1
expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
case "$(cat "$work/stderr")" in
  *'missing required tool: sed'*) : ;;
  *)
    printf '%s\n' 'FAIL: missing sed diagnostic' >&2
    exit 1
    ;;
esac
mv "$work/saved/sed" "$work/bin/sed"
unset DMS_PER_MONITOR

# Recover a stale mkdir lock, then verify the no-setsid launch path.
export VARIETYCTL_BACKEND=swaybg
if [ -e "$work/bin/flock" ]; then mv "$work/bin/flock" "$work/saved/flock"; fi
mkdir "$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock.d"
sleep 1 &
dead_owner=$!
kill "$dead_owner"
wait "$dead_owner" 2> /dev/null || :
printf '%s\n' "$dead_owner" > "$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock.d/pid"
jobs=
burst=0
while [ "$burst" -lt 10 ]; do
  "$test_shell" "$controller" set "$work/images/space name.jpg" &
  jobs="$jobs $!"
  burst=$((burst + 1))
done
for job in $jobs; do wait "$job"; done
check test ! -d "$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock.d"
if [ -e "$work/saved/flock" ]; then mv "$work/saved/flock" "$work/bin/flock"; fi
if [ -e "$work/bin/setsid" ]; then mv "$work/bin/setsid" "$work/saved/setsid"; fi
VARIETYCTL_BACKEND=swaybg "$test_shell" "$controller" set "$work/images/space name.jpg"
if [ -e "$work/saved/setsid" ]; then mv "$work/saved/setsid" "$work/bin/setsid"; fi

# A POSIX ln/mv implementation can reject -- and -T; absolute operands stay safe.
# Keep backing utility basenames: Nix's multicall coreutils dispatches on argv[0].
mv "$work/bin/ln" "$work/saved/ln"
mv "$work/bin/mv" "$work/saved/mv"
cat > "$work/bin/ln" << 'STUB'
#!/bin/sh
# Models POSIX ln -s without GNU's -- extension.
[ "${2:-}" != -- ] || exit 2
exec "$work/saved/ln" "$@"
STUB
cat > "$work/bin/mv" << 'STUB'
#!/bin/sh
# Records the modern swap and models POSIX mv rejecting GNU's -T/-- options.
printf '%s\n' "$*" >>"$work/mv-calls"
if [ "${TEST_POSIX_MV:-0}" = 1 ]; then
  for argument; do case "$argument" in -T | --) exit 2 ;; esac; done
fi
exec "$work/saved/mv" "$@"
STUB
chmod +x "$work/bin/ln" "$work/bin/mv"
: > "$work/mv-calls"
VARIETYCTL_LOCKSCREEN_LINK="$work/modern/link" XDG_CURRENT_DESKTOP=niri \
  "$test_shell" "$controller" set-lockscreen "$work/images/space name.jpg"
check test "$(awk 'END {print NR}' "$work/mv-calls")" -eq 1
IFS= read -r first_swap < "$work/mv-calls"
case "$first_swap" in '-f -T '*) : ;; *) exit 1 ;; esac
check test "$(readlink "$work/modern/link")" = "$work/images/space name.jpg"
: > "$work/mv-calls"
TEST_POSIX_MV=1 VARIETYCTL_LOCKSCREEN_LINK="$work/posix/link" XDG_CURRENT_DESKTOP=niri \
  "$test_shell" "$controller" set-lockscreen "$work/images/space name.jpg"
check test "$(awk 'END {print NR}' "$work/mv-calls")" -eq 2
check test "$(readlink "$work/posix/link")" = "$work/images/space name.jpg"
rm "$work/bin/ln" "$work/bin/mv"
"$work/saved/mv" "$work/saved/ln" "$work/bin/ln"
"$work/saved/mv" "$work/saved/mv" "$work/bin/mv"

# flock's documented timeout status is distinct from an unsupported option.
export VARIETYCTL_BACKEND=swaybg
if [ -e "$work/bin/flock" ]; then mv "$work/bin/flock" "$work/saved/flock"; fi
mv "$work/bin/mkdir" "$work/saved/mkdir"
cat > "$work/bin/flock" << 'STUB'
#!/bin/sh
# Models util-linux's documented -E conflict status and option-error status.
[ "$*" = '-E 200 -w 10 9' ] || exit 2
exit "${FLOCK_STATUS:-2}"
STUB
cat > "$work/bin/mkdir" << 'STUB'
#!/bin/sh
# Passes real mkdir argv through and records whether fallback was attempted.
printf '%s\n' "$*" >> "$work/mkdir-calls"
exec "$work/saved/mkdir" "$@"
STUB
chmod +x "$work/bin/flock" "$work/bin/mkdir"
: > "$work/mkdir-calls"
FLOCK_STATUS=2 "$test_shell" "$controller" set "$work/images/space name.jpg"
check test -s "$work/mkdir-calls"
: > "$work/mkdir-calls"
FLOCK_STATUS=200 expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
check test ! -s "$work/mkdir-calls"
rm "$work/bin/flock" "$work/bin/mkdir"
mv "$work/saved/mkdir" "$work/bin/mkdir"

# Empty-lock recovery waits to its bound; it must never reclaim a live owner.
mv "$work/bin/sleep" "$work/saved/sleep"
cat > "$work/bin/sleep" << 'STUB'
#!/bin/sh
# A fake clock for directory-lock tests; 0.1 is supported by installed sleep.
if [ "${TEST_FAST_SLEEP:-0}" = 1 ] && [ "$*" = 0.1 ]; then
  printf '%s\n' tick >> "$work/sleep-calls"
  exit 0
fi
exec "$work/saved/sleep" "$@"
STUB
chmod +x "$work/bin/sleep"
empty_lock=$XDG_RUNTIME_DIR/varietyctl-$test_uid.lock.d
mkdir "$empty_lock"
: > "$work/sleep-calls"
TEST_FAST_SLEEP=1 "$test_shell" "$controller" set "$work/images/space name.jpg"
check test ! -d "$empty_lock"
check test "$(awk 'END {print NR}' "$work/sleep-calls")" -eq 104
mkdir "$empty_lock"
printf '%s\n' "$$" > "$empty_lock/pid"
TEST_FAST_SLEEP=1 expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
check test "$(cat "$empty_lock/pid")" = "$$"
rm "$empty_lock/pid"
rmdir "$empty_lock"
rm "$work/bin/sleep"
mv "$work/saved/sleep" "$work/bin/sleep"
if [ -e "$work/saved/flock" ]; then mv "$work/saved/flock" "$work/bin/flock"; fi

# Simulate UID/metadata in a unique /tmp namespace, never a real user's lock.
export TEST_NO_SWAY=1
# stat and ls fixtures model the exact real-tool output consumed by the code.
private_uid=$((1000000 + $$))
while [ -e "/tmp/varietyctl-$private_uid" ]; do private_uid=$((private_uid + 1)); done
private_root=/tmp/varietyctl-$private_uid
for utility in id stat ls; do
  if [ -e "$work/bin/$utility" ]; then mv "$work/bin/$utility" "$work/saved/$utility"; fi
done
cat > "$work/bin/id" << 'STUB'
#!/bin/sh
# Models POSIX id -u for a distinct simulated user.
if [ -n "${TEST_PRIVATE_UID:-}" ] && [ "$*" = -u ]; then printf '%s\n' "$TEST_PRIVATE_UID"; else exec "$work/saved/id" "$@"; fi
STUB
cat > "$work/bin/stat" << 'STUB'
#!/bin/sh
# Models GNU stat -c '%u %a' -- PATH, including foreign-owner/bad-mode cases.
[ "$1" = -c ] && [ "$2" = '%u %a' ] && [ "$3" = -- ] || exit 2
printf '%s %s\n' "${TEST_PRIVATE_OWNER:-$TEST_PRIVATE_UID}" "${TEST_PRIVATE_MODE:-700}"
STUB
cat > "$work/bin/ls" << 'STUB'
#!/bin/sh
# Models POSIX ls -and's numeric UID and permission columns for the same user.
if [ -n "${TEST_PRIVATE_UID:-}" ] && [ "$1" = -and ]; then
  printf 'drwx------ 2 %s %s 4096 Jan 1 00:00 %s\n' "${TEST_PRIVATE_OWNER:-$TEST_PRIVATE_UID}" "$TEST_PRIVATE_UID" "$2"
else
  exec "$work/saved/ls" "$@"
fi
STUB
chmod +x "$work/bin/id" "$work/bin/stat" "$work/bin/ls"
XDG_RUNTIME_DIR='' TEST_PRIVATE_UID=$private_uid "$test_shell" "$controller" set "$work/images/space name.jpg"
check test "$("$work/saved/stat" -c '%a' "$private_root")" = 700
XDG_RUNTIME_DIR='' TEST_PRIVATE_UID=$private_uid TEST_PRIVATE_OWNER=$((private_uid + 1)) \
  expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
XDG_RUNTIME_DIR='' TEST_PRIVATE_UID=$private_uid TEST_PRIVATE_MODE=755 \
  expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
mv "$work/bin/stat" "$work/stat.hidden"
XDG_RUNTIME_DIR='' TEST_PRIVATE_UID=$private_uid "$test_shell" "$controller" set "$work/images/space name.jpg"
XDG_RUNTIME_DIR='' TEST_PRIVATE_UID=$private_uid TEST_PRIVATE_OWNER=$((private_uid + 1)) \
  expect_status 1 "$test_shell" "$controller" set "$work/images/space name.jpg"
rm "$private_root/set.lock"
rmdir "$private_root"
private_root=
for utility in id ls; do
  rm "$work/bin/$utility"
  mv "$work/saved/$utility" "$work/bin/$utility"
done
if [ -e "$work/saved/stat" ]; then mv "$work/saved/stat" "$work/bin/stat"; fi

unset TEST_NO_SWAY

# New backend variable wins; old spelling remains a supported alias.
WALLPAPER_BACKEND=invalid VARIETYCTL_BACKEND=dms "$test_shell" "$controller" set "$work/images/space name.jpg"
unset VARIETYCTL_BACKEND
WALLPAPER_BACKEND=dms "$test_shell" "$controller" set "$work/images/space name.jpg"
# Supply evaluated Nix wrappers to also exercise the production wrapper generator.
if [ -n "${VARIETYCTL_TEST_WRAPPER:-}" ]; then
  for posix in 0 1; do
    VARIETYCTL_POSIX_ONLY=$posix VARIETYCTL_BACKEND=stale WALLPAPER_BACKEND=stale \
      "$test_shell" "$VARIETYCTL_TEST_WRAPPER" get > "$work/actual"
    printf '%s\n' "$work/images/space name.jpg" > "$work/expected"
    check cmp "$work/expected" "$work/actual"
    actual=$(VARIETYCTL_BACKEND=stale VARIETYCTL_CAPTURE_BACKEND=1 \
      "$test_shell" "$VARIETYCTL_TEST_QUOTED_WRAPPER" next)
    check test "$actual" = "$VARIETYCTL_TEST_QUOTED_BACKEND"
  done
fi

expect_status 2 "$test_shell" "$controller" unknown
expect_status 2 "$test_shell" "$controller" set
export VARIETYCTL_BACKEND=invalid
expect_status 2 "$test_shell" "$controller" get
export VARIETYCTL_BACKEND=swaybg
expect_status 0 env XDG_CURRENT_DESKTOP=unsupported WAYLAND_DISPLAY='' VARIETYCTL_DEBUG=1 "$test_shell" "$controller" set-lockscreen "$work/images/space name.jpg"
case "$(cat "$work/stderr")" in *'unsupported session; skipping lock screen change'*) : ;; *) exit 1 ;; esac
check test ! -s "$work/stdout"
VARIETYCTL_DEBUG=1 "$test_shell" "$controller" get > "$work/actual" 2> "$work/stderr"
check test -s "$work/stderr"
VARIETYCTL_DEBUG=0 "$test_shell" "$controller" get > "$work/actual" 2> "$work/stderr"
check test ! -s "$work/stderr"
printf '%s\n' 'All varietyctl checks passed.'
